#: src/window.py:863
msgid "Check the log for details."
msgstr "A részletekért nézze meg a naplót."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Az eszköz nem található. Csatlakoztassa újra, és próbálja meg ismét"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Az eszköz újraindul"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Nem sikerült kilépni a helyreállítási módból"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Az eszköz helyreállítási módban indul újra"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Nem sikerült belépni a helyreállítási módba. Oldja fel az eszköz zárolását, "
"és bízzon meg ebben a számítógépben"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Leállítja és kilép?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Egy eszköz visszaállítása folyamatban van. Ha most megszakítja, az "
"használhatatlanná válhat a következő visszaállításig."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Leállítás és kilépés"

