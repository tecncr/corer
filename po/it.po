msgid "Corer needs permission to access this device over USB"
msgstr ""
"Corer ha bisogno del permesso di accedere a questo dispositivo tramite USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Configura"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Il servizio dispositivi di sistema (usbmuxd) non risponde"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Riavvialo"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Il servizio dispositivi (usbmuxd) non è disponibile"

#: src/window.py:260
msgid "USB access was set up"
msgstr "L’accesso USB è stato configurato"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Il servizio dispositivi è stato riavviato"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Impossibile riavviarlo. Esegui «sudo systemctl restart usbmuxd» in un "
"terminale"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Configura manualmente l’accesso USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Impossibile completare la configurazione. Esegui questi comandi in un "
"terminale per installare la regola di accesso al dispositivo, quindi "
"ricollega il dispositivo."

#: src/window.py:301
msgid "_Close"
msgstr "_Chiudi"

#: src/window.py:302
