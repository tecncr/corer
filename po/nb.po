#: data/com.tecncr.Corer.desktop.in.in:2
#: data/com.tecncr.Corer.metainfo.xml.in.in:7 src/window.ui:6
msgid "Corer"
msgstr "Corer"

#. Translators: Short description shown in GNOME Shell search and app grids.
#. Keep it under 80 characters.
#: data/com.tecncr.Corer.desktop.in.in:5
msgid "Restore firmware to Apple devices"
msgstr "Gjenopprett fastvare på Apple-enheter"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: data/com.tecncr.Corer.desktop.in.in:12
msgid ""
"iOS;iPhone;iPad;Mac;macOS;Apple;Firmware;Restore;Update;IPSW;Recovery;DFU;"
msgstr ""
"iOS;iPhone;iPad;Mac;macOS;Apple;Firmware;Fastvare;Restore;Gjenopprett;Update;Oppdater;IPSW;Recovery;DFU;"

#: data/com.tecncr.Corer.gschema.xml:6
msgid "Window width"
msgstr "Vindusbredde"

#: data/com.tecncr.Corer.gschema.xml:10
msgid "Window height"
msgstr "Vindushøyde"

#: data/com.tecncr.Corer.gschema.xml:14
msgid "Whether the window is maximized"
msgstr "Om vinduet er maksimert"

#: data/com.tecncr.Corer.gschema.xml:18
msgid "Keep downloaded firmware"
msgstr "Behold nedlastet fastvare"

#: data/com.tecncr.Corer.gschema.xml:19
msgid ""
"Keep downloaded firmware files in the cache after a successful restore so "
"they can be reused."
msgstr ""
"Beholder nedlastede fastvarefiler i hurtigbufferen etter en vellykket "
"gjenoppretting slik at de kan gjenbrukes."

#: data/com.tecncr.Corer.gschema.xml:23
msgid "Verbose logging"
msgstr "Detaljert logging"

#: data/com.tecncr.Corer.gschema.xml:24
msgid "Ask idevicerestore to print additional debug output."
msgstr "Ber idevicerestore om å skrive ut ekstra feilsøkingsinformasjon."

#: data/com.tecncr.Corer.gschema.xml:28
msgid "Allow restoring from restore mode"
msgstr "Tillat gjenoppretting fra gjenopprettingsmodus"

#: data/com.tecncr.Corer.gschema.xml:32
msgid "Continue after certain errors"
msgstr "Fortsett etter visse feil"

#: data/com.tecncr.Corer.gschema.xml:33
msgid ""
"Try to continue the restore process after certain errors, like a failed "
"baseband update."
msgstr ""
"Prøver å fortsette gjenopprettingen etter visse feil, for eksempel en "
"mislykket baseband-oppdatering."

#: data/com.tecncr.Corer.gschema.xml:37
msgid "Skip NOR and baseband upgrade"
msgstr "Hopp over oppgradering av NOR og baseband"

#: data/com.tecncr.Corer.gschema.xml:41
msgid "Keep personalized components"
msgstr "Behold tilpassede komponenter"

#: data/com.tecncr.Corer.gschema.xml:42
msgid "Write personalized components to files for debugging."
msgstr "Skriver tilpassede komponenter til filer for feilsøking."

#: data/com.tecncr.Corer.gschema.xml:46
msgid "Restore custom firmware"
msgstr "Gjenopprett egendefinert fastvare"

#: data/com.tecncr.Corer.gschema.xml:47
msgid "Restore with a custom firmware. Requires a bootrom exploit."
msgstr ""
"Gjenoppretter med egendefinert fastvare. Krever en bootrom-utnyttelse."

#: data/com.tecncr.Corer.gschema.xml:51
msgid "Stop after booting the ramdisk"
msgstr "Stopp etter oppstart av ramdisk"

#: data/com.tecncr.Corer.gschema.xml:55
msgid "Signing server URL"
msgstr "URL til signeringstjener"

#: data/com.tecncr.Corer.gschema.xml:56
msgid ""
"Overrides the default signing server request URL. Empty uses the default."
msgstr ""
"Overstyrer standard-URL for forespørsler til signeringstjeneren. Hvis den er"
" tom, brukes standarden."

#: data/com.tecncr.Corer.gschema.xml:60
msgid "Restore variant"
msgstr "Gjenopprettingsvariant"

#: data/com.tecncr.Corer.gschema.xml:61
msgid "Build identity variant to use. Empty selects it automatically."
msgstr ""
"Bygge-identitetsvarianten som skal brukes. Hvis den er tom, velges den "
"automatisk."

#: data/com.tecncr.Corer.metainfo.xml.in.in:8
msgid "Restore and update Apple devices"
msgstr "Gjenopprett og oppdater Apple-enheter"

#: data/com.tecncr.Corer.metainfo.xml.in.in:10
msgid ""
"Corer installs firmware on Apple devices, including Mac computers with Apple"
" silicon in DFU mode. Connect a device, pick a version and choose whether to"
" keep or erase its content."
msgstr ""
"Corer installerer fastvare på Apple-enheter, inkludert Mac-maskiner med "
"Apple silicon i DFU-modus. Koble til en enhet, velg en versjon og bestem om "
"innholdet skal beholdes eller slettes."

#: data/com.tecncr.Corer.metainfo.xml.in.in:16
msgid "Update a device while keeping its data, or erase and restore it"
msgstr "Oppdater en enhet og behold dataene, eller slett og gjenopprett den"

#: data/com.tecncr.Corer.metainfo.xml.in.in:17
msgid "Download currently signed firmware on demand and reuse it later"
msgstr "Last ned gjeldende signert fastvare ved behov og gjenbruk den senere"

#: data/com.tecncr.Corer.metainfo.xml.in.in:18
msgid "Use a firmware file you already have"
msgstr "Bruk en fastvarefil du allerede har"

#: data/com.tecncr.Corer.metainfo.xml.in.in:19
msgid "Recover devices stuck in recovery or DFU mode"
msgstr "Redd enheter som sitter fast i gjenopprettings- eller DFU-modus"

#: data/com.tecncr.Corer.metainfo.xml.in.in:21
msgid ""
"Corer is powered by idevicerestore and libimobiledevice. It is not "
"affiliated with or endorsed by Apple Inc."
msgstr ""
"Corer drives av idevicerestore og libimobiledevice. Det er ikke tilknyttet "
"eller godkjent av Apple Inc."

#: src/devices.py:89
msgid "Recovery Mode"
msgstr "Gjenopprettingsmodus"

#: src/devices.py:91
msgid "DFU Mode"
msgstr "DFU-modus"

#: src/firmware.py:145 src/firmware.py:150
msgid "Could not load the list of available versions"
msgstr "Kunne ikke laste listen over tilgjengelige versjoner"

#: src/firmware.py:185
msgid "This is not a valid firmware file"
msgstr "Dette er ikke en gyldig fastvarefil"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Denne fastvaren er ikke tilgjengelig for nedlasting"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Ikke nok ledig diskplass til å laste ned fastvaren"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Nedlastingstjeneren avviste forespørselen"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Nedlastingen mislyktes. Sjekk nettverkstilkoblingen"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Den nedlastede fastvaren er ufullstendig"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Den nedlastede fastvaren er ødelagt"

#: src/log_dialog.py:16
msgid "Log"
msgstr "Logg"

#: src/log_dialog.py:24
msgid "Copy"
msgstr "Kopier"

#: src/log_dialog.py:28
msgid "Save…"
msgstr "Lagre …"

#: src/log_dialog.py:36
msgid "No Log Yet"
msgstr "Ingen logg ennå"

#: src/log_dialog.py:37
msgid "Output appears here when a device is restored."
msgstr "Utdata vises her når en enhet gjenopprettes."

#: src/log_dialog.py:81 src/window.py:310
msgid "Copied to clipboard"
msgstr "Kopiert til utklippstavlen"

#: src/log_dialog.py:84
