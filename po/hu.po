#: src/preferences.py:60
msgid ""
"These options can leave a device unable to start. Change them only if you "
"know what they do."
msgstr ""
"Ezek a beállítások az eszköz indíthatatlanságát okozhatják. Csak akkor "
"módosítsa őket, ha tudja, mit csinálnak."

#: src/preferences.py:64
msgid "Restore From _Restore Mode"
msgstr "Visszaállítás _visszaállítási módból"

#: src/preferences.py:65
