msgid "The download server refused the request"
msgstr "Сервер завантаження відхилив запит"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Не вдалося завантажити. Перевірте з’єднання з мережею"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Завантажена мікропрограма неповна"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Завантажена мікропрограма пошкоджена"

