#: src/window.py:218
msgid "_Set Up"
msgstr "_მორგება"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "სისტემის მოწყობილობების სერვისი (usbmuxd) არ პასუხობს"

