msgstr "Apple-enhet"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer behöver behörighet för att komma åt den här enheten via USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Konfigurera"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Systemets enhetstjänst (usbmuxd) svarar inte"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Starta om den"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Enhetstjänsten (usbmuxd) är inte tillgänglig"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB-åtkomst har konfigurerats"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Enhetstjänsten har startats om"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Det gick inte att starta om. Kör ”sudo systemctl restart usbmuxd” i en "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Konfigurera USB-åtkomst manuellt"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Konfigurationen kunde inte slutföras. Kör de här kommandona i en terminal "
"för att installera regeln för enhetsåtkomst och anslut sedan enheten igen."

#: src/window.py:301
msgid "_Close"
msgstr "_Stäng"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "K_opiera kommandon"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Letar efter tillgängliga versioner …"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Välj en fil med inbyggd programvara för den här enheten"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr ""
"Ingen inbyggd programvara är för närvarande signerad för den här enheten"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Använder filen med inbyggd programvara"

#: src/window.py:422
msgid "Downloaded"
msgstr "Hämtad"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} hämtning"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Offline – visar hämtad inbyggd programvara"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Använd en IPSW-fil från den här datorn"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} är inte kompatibel med den här enheten"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Radera och återställ"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Uppdatera"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Avsluta _återställningsläge"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Starta _återställningsläge"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Filer med inbyggd programvara"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Välj fil med inbyggd programvara"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Den här filen kan inte användas"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Radera ”{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Allt innehåll och alla inställningar raderas permanent och {version} "
"installeras. Detta kan inte ångras."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Uppdatera ”{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} installeras och ditt innehåll och dina inställningar behålls. Se "
"till att du har en säkerhetskopia innan du fortsätter."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Den här versionen är äldre än den som finns på enheten. Att nedgradera utan "
"att radera misslyckas troligen och kan leda till fullständig dataförlust."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Den här inbyggda programvaran verkar inte längre vara signerad, så enheten "
"kommer troligen att avvisa den."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Låt enheten vara ansluten tills processen är klar."

#: src/window.py:628
msgid "A device is being restored"
msgstr "En enhet återställs"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Verifierar inbyggd programvara"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Hämtar inbyggd programvara"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} av {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Stoppa processen?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Om du avbryter nu kan enheten bli oanvändbar tills den återställs igen."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Fortsätt"

#: src/window.py:789
msgid "_Stop"
msgstr "_Stoppa"

#: src/window.py:807
msgid "Stopping…"
msgstr "Stoppar …"

#: src/window.py:839
msgid "Stopped"
msgstr "Stoppad"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH-blobbar sparade"

#: src/window.py:845
msgid "Device Restored"
msgstr "Enheten återställd"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Enheten startar om och visar installationsassistenten."

#: src/window.py:849
msgid "Device Updated"
msgstr "Enheten uppdaterad"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Enheten startar om när uppdateringen är klar."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Det gick inte att spara SHSH-blobbar"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Återställningen misslyckades"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Se loggen för mer information."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Enheten hittades inte. Anslut den igen och försök på nytt"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Enheten startar om"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Det gick inte att avsluta återställningsläget"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Enheten startar om i återställningsläge"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Det gick inte att starta återställningsläget. Lås upp enheten och lita på "
"den här datorn"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Stoppa och avsluta?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"En enhet återställs. Om du avbryter nu kan den bli oanvändbar tills den "
"återställs igen."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Stoppa och avsluta"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Huvudmeny"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Anslut en enhet"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Anslut en Apple-enhet med en USB-kabel. Enheter i återställnings- eller DFU-"
"läge fungerar också. En Mac med Apple silicon måste vara i DFU-läge."

