msgstr "Wybierz plik oprogramowania układowego"

#: src/shortcuts-dialog.ui:15
msgctxt "shortcut window"
msgid "Look for Devices"
msgstr "Szukaj urządzeń"

#: src/shortcuts-dialog.ui:21
