msgstr "_Պատճենել հրամանները"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Հասանելի տարբերակների որոնում…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Ընտրեք որոնիչի ֆայլ այս սարքի համար"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Այս պահին այս սարքի համար ստորագրված որոնիչ չկա"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Օգտագործվում է որոնիչի ֆայլը"

#: src/window.py:422
msgid "Downloaded"
msgstr "Ներբեռնված է"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} ներբեռնում"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Անցանց — ցուցադրվում է ներբեռնված որոնիչը"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Օգտագործել IPSW ֆայլ այս համակարգչից"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename}-ը համատեղելի չէ այս սարքի հետ"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Ջնջել և վերականգնել"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Թարմացնել"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Դուրս գալ _վերականգնման ռեժիմից"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Մտնել _վերականգնման ռեժիմ"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Որոնիչի ֆայլեր"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Ընտրել որոնիչի ֆայլ"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Այս ֆայլը չի կարող օգտագործվել"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Ջնջե՞լ «{name}»-ը"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Ողջ բովանդակությունը և կարգավորումները մշտապես կջնջվեն, և կտեղադրվի "
"{version}-ը։ Սա հնարավոր չէ հետարկել։"

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Թարմացնե՞լ «{name}»-ը"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Կտեղադրվի {version}-ը, իսկ ձեր բովանդակությունն ու կարգավորումները "
"կպահպանվեն։ Շարունակելուց առաջ համոզվեք, որ պահուստային պատճեն ունեք։"

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Այս տարբերակն ավելի հին է, քան սարքում եղածը։ Առանց ջնջելու վերադառնալը, "
"ամենայն հավանականությամբ, կձախողվի և կարող է առաջացնել տվյալների լրիվ "
"կորուստ։"

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Թվում է՝ այս որոնիչն այլևս ստորագրված չէ, ուստի սարքը, ամենայն "
"հավանականությամբ, կմերժի այն։"

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Սարքը մնացեք միացված, մինչև գործընթացն ավարտվի։"

#: src/window.py:628
msgid "A device is being restored"
msgstr "Սարքը վերականգնվում է"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Որոնիչի ստուգում"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Որոնիչի ներբեռնում"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done}՝ {total}-ից"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/վ"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Կանգնեցնե՞լ գործընթացը"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Հիմա ընդհատելը կարող է սարքը անգործածելի դարձնել, մինչև այն նորից "
"վերականգնվի։"

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Շարունակել"

#: src/window.py:789
msgid "_Stop"
msgstr "_Կանգնեցնել"

#: src/window.py:807
msgid "Stopping…"
msgstr "Կանգնեցվում է…"

#: src/window.py:839
msgid "Stopped"
msgstr "Կանգնեցվեց"

