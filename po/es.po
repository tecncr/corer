msgstr "Corer necesita permiso para acceder a este dispositivo por USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Configurar"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "El servicio de dispositivos del sistema (usbmuxd) no responde"

#: src/window.py:224
