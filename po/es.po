#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} no es compatible con este dispositivo"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Borrar y restaurar"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Actualizar"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "_Salir del modo de recuperación"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_Entrar en modo de recuperación"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Archivos de firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Elegir un archivo de firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "No se puede usar este archivo"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "¿Borrar «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Todo el contenido y los ajustes se borrarán de forma permanente y se "
"instalará {version}. Esta acción no se puede deshacer."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "¿Actualizar «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make "
"sure you have a backup before continuing."
msgstr ""
"Se instalará {version} y se conservarán su contenido y sus ajustes. "
"Asegúrese de tener una copia de seguridad antes de continuar."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Esta versión es anterior a la del dispositivo. Volver a una versión anterior "
"sin borrar probablemente falle y puede provocar la pérdida total de los "
"datos."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Parece que este firmware ya no está firmado, por lo que es probable que el "
"dispositivo lo rechace."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Mantenga el dispositivo conectado hasta que termine el proceso."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Se está restaurando un dispositivo"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Verificando el firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Descargando el firmware"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} de {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "¿Detener el proceso?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Si lo interrumpe ahora, el dispositivo puede quedar inutilizable hasta que "
"se restaure de nuevo."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continuar"

#: src/window.py:789
msgid "_Stop"
msgstr "_Detener"

#: src/window.py:807
msgid "Stopping…"
msgstr "Deteniendo…"

#: src/window.py:839
msgid "Stopped"
msgstr "Detenido"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Blobs SHSH guardados"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispositivo restaurado"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "El dispositivo se reiniciará y mostrará el asistente de configuración."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispositivo actualizado"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "El dispositivo se reiniciará cuando termine de actualizarse."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "No se pudieron guardar los blobs SHSH"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Falló la restauración"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consulte el registro para ver los detalles."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr ""
"No se encontró el dispositivo. Vuelva a conectarlo e inténtelo de nuevo"

#: src/window.py:925
msgid "The device is restarting"
msgstr "El dispositivo se está reiniciando"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "No se pudo salir del modo de recuperación"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "El dispositivo se está reiniciando en modo de recuperación"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"No se pudo entrar en modo de recuperación. Desbloquee el dispositivo y "
"confíe en este equipo"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "¿Detener y salir?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Se está restaurando un dispositivo. Si lo interrumpe ahora, puede quedar "
"inutilizable hasta que se restaure de nuevo."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Detener y salir"

