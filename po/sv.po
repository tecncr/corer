msgstr "Den här inbyggda programvaran är inte tillgänglig för hämtning"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr ""
"Det finns inte tillräckligt med ledigt diskutrymme för att hämta den "
"inbyggda programvaran"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Hämtningsservern avvisade förfrågan"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Hämtningen misslyckades. Kontrollera nätverksanslutningen"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Den hämtade inbyggda programvaran är ofullständig"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Den hämtade inbyggda programvaran är skadad"

