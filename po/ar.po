msgstr "يحتاج Corer إلى إذن للوصول إلى هذا الجهاز عبر USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_إعداد"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "خدمة الأجهزة في النظام (usbmuxd) لا تستجيب"

#: src/window.py:224
msgid "_Restart It"
msgstr "_إعادة التشغيل"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "خدمة الأجهزة (usbmuxd) غير متاحة"

#: src/window.py:260
msgid "USB access was set up"
msgstr "تم إعداد الوصول عبر USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "أُعيد تشغيل خدمة الأجهزة"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"تعذّرت إعادة التشغيل. شغّل «sudo systemctl restart usbmuxd» في الطرفية"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "إعداد الوصول عبر USB يدويًا"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"تعذّر إكمال الإعداد. شغّل هذه الأوامر في الطرفية لتثبيت قاعدة الوصول إلى "
"الجهاز، ثم أعد توصيل الجهاز."

