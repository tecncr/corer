msgstr ""
"Prøver å fortsette etter visse feil, for eksempel en mislykket baseband-"
"oppdatering"

#: src/preferences.py:71
msgid "Skip _Baseband"
msgstr "Hopp over _baseband"

#: src/preferences.py:72
msgid "Do not upgrade NOR and baseband on legacy devices"
msgstr "Ikke oppgrader NOR og baseband på eldre enheter"

