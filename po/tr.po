#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} indirme"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Çevrim dışı — indirilen aygıt yazılımı gösteriliyor"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Bu bilgisayardaki bir IPSW dosyasını kullan"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} bu aygıtla uyumlu değil"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Sil ve Geri Yükle"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Güncelle"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "_Kurtarma Kipinden Çık"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_Kurtarma Kipine Gir"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Aygıt Yazılımı Dosyaları"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Aygıt Yazılımı Dosyası Seç"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Bu dosya kullanılamaz"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "“{name}” silinsin mi?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Tüm içerik ve ayarlar kalıcı olarak silinecek ve {version} yüklenecek. Bu "
"işlem geri alınamaz."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "“{name}” güncellensin mi?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} yüklenecek ve içeriğiniz ile ayarlarınız korunacak. Devam etmeden "
"önce yedeğiniz olduğundan emin olun."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Bu sürüm aygıttaki sürümden daha eski. Silmeden sürüm düşürmenin başarısız "
"olma olasılığı yüksektir ve tüm verilerin kaybına neden olabilir."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Bu aygıt yazılımı artık imzalı görünmüyor, bu nedenle aygıt büyük olasılıkla"
" onu reddedecek."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "İşlem bitene kadar aygıtı bağlı tutun."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Bir aygıt geri yükleniyor"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Aygıt Yazılımı Doğrulanıyor"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Aygıt Yazılımı İndiriliyor"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/sn"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "İşlem Durdurulsun mu?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Şimdi kesmek, aygıtı yeniden geri yüklenene kadar kullanılamaz hale "
"getirebilir."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Devam Et"

#: src/window.py:789
msgid "_Stop"
msgstr "_Durdur"

#: src/window.py:807
msgid "Stopping…"
msgstr "Durduruluyor…"

#: src/window.py:839
msgid "Stopped"
msgstr "Durduruldu"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH Blob'ları Kaydedildi"

#: src/window.py:845
msgid "Device Restored"
msgstr "Aygıt Geri Yüklendi"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Aygıt yeniden başlayacak ve kurulum yardımcısını gösterecek."

#: src/window.py:849
msgid "Device Updated"
msgstr "Aygıt Güncellendi"

