msgid "Could not load the list of available versions"
msgstr "Nije moguće učitati popis dostupnih verzija"

#: src/firmware.py:185
msgid "This is not a valid firmware file"
msgstr "Ovo nije ispravna datoteka firmwarea"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Ovaj firmware nije dostupan za preuzimanje"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Nema dovoljno slobodnog prostora na disku za preuzimanje firmwarea"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Poslužitelj za preuzimanje odbio je zahtjev"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Preuzimanje nije uspjelo. Provjerite mrežnu vezu"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Preuzeti firmware je nepotpun"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Preuzeti firmware je oštećen"

#: src/log_dialog.py:16
msgid "Log"
msgstr "Zapisnik"

#: src/log_dialog.py:24
msgid "Copy"
msgstr "Kopiraj"

#: src/log_dialog.py:28
msgid "Save…"
msgstr "Spremi…"

#: src/log_dialog.py:36
msgid "No Log Yet"
msgstr "Još nema zapisnika"

#: src/log_dialog.py:37
msgid "Output appears here when a device is restored."
msgstr "Izlaz će se pojaviti ovdje kada se uređaj bude vraćao."

