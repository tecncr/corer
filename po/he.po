#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "המכשיר לא נמצא. חברו אותו מחדש ונסו שוב"

#: src/window.py:925
msgid "The device is restarting"
msgstr "המכשיר מופעל מחדש"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "לא ניתן היה לצאת ממצב שחזור"

