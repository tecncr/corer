msgstr "Đây không phải là tệp firmware hợp lệ"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Firmware này không có sẵn để tải về"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Không đủ dung lượng trống trên đĩa để tải firmware"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Máy chủ tải về đã từ chối yêu cầu"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Tải về không thành công. Hãy kiểm tra kết nối mạng"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Firmware đã tải về chưa hoàn chỉnh"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Firmware đã tải về bị hỏng"

