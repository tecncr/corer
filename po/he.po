msgstr "הורדה של {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "לא מקוון — מוצגת קושחה שהורדה"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "שימוש בקובץ IPSW ממחשב זה"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "הקובץ {filename} אינו תואם למכשיר זה"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_מחיקה ושחזור"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_עדכון"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "יציאה _ממצב שחזור"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "כניסה _למצב שחזור"

#: src/window.py:502
msgid "Firmware Files"
msgstr "קובצי קושחה"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "בחירת קובץ קושחה"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "לא ניתן להשתמש בקובץ זה"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "למחוק את „{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"כל התוכן וההגדרות יימחקו לצמיתות ו־{version} יותקן. לא ניתן לבטל פעולה זו."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "לעדכן את „{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} יותקן והתוכן וההגדרות שלכם יישמרו. ודאו שיש לכם גיבוי לפני "
"שתמשיכו."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"גרסה זו ישנה יותר מהגרסה שבמכשיר. סביר שהחזרה לגרסה ישנה יותר ללא מחיקה "
"תיכשל ועלולה לגרום לאובדן מוחלט של הנתונים."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr "נראה שקושחה זו אינה חתומה עוד, ולכן סביר שהמכשיר ידחה אותה."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
