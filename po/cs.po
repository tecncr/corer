msgstr "_Zavřít"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopírovat příkazy"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Hledají se dostupné verze…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Vyberte soubor firmwaru pro toto zařízení"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Pro toto zařízení momentálně není podepsán žádný firmware"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Použitý soubor firmwaru"

#: src/window.py:422
msgid "Downloaded"
msgstr "Staženo"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Stažení {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Offline – zobrazuje se stažený firmware"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Použít soubor IPSW z tohoto počítače"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "Soubor {filename} není s tímto zařízením kompatibilní"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Vymazat a obnovit"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Aktualizovat"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Ukončit _režim obnovy"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Spustit _režim obnovy"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Soubory firmwaru"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Vybrat soubor firmwaru"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Tento soubor nelze použít"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Vymazat „{name}“?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Veškerý obsah a nastavení budou trvale vymazány a bude nainstalován systém "
"{version}. Tuto akci nelze vrátit zpět."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Aktualizovat „{name}“?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Bude nainstalován systém {version} a váš obsah a nastavení zůstanou "
"zachovány. Před pokračováním se ujistěte, že máte zálohu."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Tato verze je starší než verze v zařízení. Přechod na starší verzi bez "
"vymazání pravděpodobně selže a může způsobit úplnou ztrátu dat."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Tento firmware již zřejmě není podepsán, takže jej zařízení pravděpodobně "
"odmítne."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Ponechte zařízení připojené, dokud proces neskončí."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Probíhá obnova zařízení"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Ověřování firmwaru"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Stahování firmwaru"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} z {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Zastavit proces?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Přerušení nyní může způsobit, že zařízení bude nepoužitelné, dokud nebude "
"znovu obnoveno."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Pokračovat"

#: src/window.py:789
msgid "_Stop"
msgstr "_Zastavit"

#: src/window.py:807
msgid "Stopping…"
msgstr "Zastavuje se…"

#: src/window.py:839
msgid "Stopped"
msgstr "Zastaveno"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Blobs SHSH uloženy"

#: src/window.py:845
msgid "Device Restored"
msgstr "Zařízení obnoveno"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Zařízení se restartuje a zobrazí asistenta nastavení."

#: src/window.py:849
msgid "Device Updated"
msgstr "Zařízení aktualizováno"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Zařízení se po dokončení aktualizace restartuje."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Blobs SHSH se nepodařilo uložit"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Obnova se nezdařila"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Podrobnosti naleznete v protokolu."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Zařízení nebylo nalezeno. Znovu je připojte a zkuste to znovu"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Zařízení se restartuje"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Nepodařilo se ukončit režim obnovy"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Zařízení se restartuje do režimu obnovy"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
