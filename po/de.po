msgid "The download server refused the request"
msgstr "Der Download-Server hat die Anfrage abgelehnt"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Der Download ist fehlgeschlagen. Prüfen Sie Ihre Netzwerkverbindung"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Die heruntergeladene Firmware ist unvollständig"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Die heruntergeladene Firmware ist beschädigt"

