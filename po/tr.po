msgid "The download server refused the request"
msgstr "İndirme sunucusu isteği reddetti"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "İndirme başarısız oldu. Ağ bağlantınızı denetleyin"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "İndirilen aygıt yazılımı eksik"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "İndirilen aygıt yazılımı bozuk"

