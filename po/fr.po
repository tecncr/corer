msgid "Firmware Files"
msgstr "Fichiers de micrologiciel"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Choisir un fichier de micrologiciel"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Ce fichier ne peut pas être utilisé"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Effacer « {name} » ?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Tout le contenu et tous les réglages seront définitivement effacés et "
"{version} sera installé. Cette action est irréversible."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Mettre à jour « {name} » ?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} sera installé et votre contenu ainsi que vos réglages seront "
"conservés. Assurez-vous d’avoir une sauvegarde avant de continuer."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Cette version est plus ancienne que celle de l’appareil. Rétrograder sans "
"effacer risque d’échouer et peut entraîner une perte totale des données."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Ce micrologiciel ne semble plus signé, l’appareil le refusera donc "
"probablement."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Gardez l’appareil connecté jusqu’à la fin du processus."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Un appareil est en cours de restauration"

