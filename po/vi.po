#: src/window.py:218
msgid "_Set Up"
msgstr "_Thiết lập"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Dịch vụ thiết bị của hệ thống (usbmuxd) không phản hồi"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Khởi động lại"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Dịch vụ thiết bị (usbmuxd) không khả dụng"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Đã thiết lập quyền truy cập USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Đã khởi động lại dịch vụ thiết bị"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Không thể khởi động lại. Hãy chạy “sudo systemctl restart usbmuxd” trong cửa"
" sổ dòng lệnh"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Thiết lập quyền truy cập USB thủ công"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Không thể hoàn tất thiết lập. Hãy chạy các lệnh này trong cửa sổ dòng lệnh "
"để cài đặt quy tắc truy cập thiết bị, sau đó kết nối lại thiết bị."

