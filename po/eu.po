#: src/window.py:149
msgid "Apple Device"
msgstr "Apple gailua"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer-ek baimena behar du gailu honetara USB bidez sartzeko"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Konfiguratu"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Sistemaren gailu-zerbitzuak (usbmuxd) ez du erantzuten"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Berrabiarazi"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Gailu-zerbitzua (usbmuxd) ez dago erabilgarri"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB bidezko sarbidea konfiguratu da"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Gailu-zerbitzua berrabiarazi da"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Ezin izan da berrabiarazi. Exekutatu «sudo systemctl restart usbmuxd» "
"terminal batean"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Konfiguratu USB bidezko sarbidea eskuz"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Ezin izan da konfigurazioa osatu. Exekutatu komando hauek terminal batean "
"gailurako sarbide-araua instalatzeko, eta gero konektatu gailua berriro."

#: src/window.py:301
msgid "_Close"
msgstr "_Itxi"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopiatu komandoak"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Eskuragarri dauden bertsioak bilatzen…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Aukeratu firmware-fitxategi bat gailu honetarako"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Une honetan ez dago firmware sinaturik gailu honetarako"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Firmware-fitxategia erabiltzen"

#: src/window.py:422
msgid "Downloaded"
msgstr "Deskargatuta"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} deskargatu"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Lineaz kanpo — deskargatutako firmwarea erakusten"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Erabili ordenagailu honetako IPSW fitxategi bat"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} ez da gailu honekin bateragarria"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Ezabatu eta leheneratu"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Eguneratu"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Irten _berreskuratze-modutik"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Sartu _berreskuratze-moduan"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Firmware-fitxategiak"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Aukeratu firmware-fitxategia"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Fitxategi hau ezin da erabili"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "«{name}» ezabatu?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Eduki eta ezarpen guztiak betiko ezabatuko dira eta {version} instalatuko "
"da. Ekintza hau ezin da desegin."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "«{name}» eguneratu?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} instalatuko da eta edukia eta ezarpenak mantenduko dira. Ziurtatu "
"babeskopia bat duzula jarraitu aurretik."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Bertsio hau gailuan dagoena baino zaharragoa da. Ezabatu gabe bertsio "
"zaharrago batera itzultzeak huts egingo duela dirudi, eta datu guztiak "
"galtzea eragin dezake."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Badirudi firmware hau ez dagoela sinatuta jada, beraz gailuak baztertuko "
"duela dirudi."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Mantendu gailua konektatuta prozesua amaitu arte."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Gailu bat leheneratzen ari da"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Firmwarea egiaztatzen"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Firmwarea deskargatzen"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Prozesua gelditu?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr "Orain eteteak gailua erabilezin utz dezake berriro leheneratu arte."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Jarraitu"

#: src/window.py:789
msgid "_Stop"
msgstr "_Gelditu"

#: src/window.py:807
msgid "Stopping…"
msgstr "Gelditzen…"

#: src/window.py:839
msgid "Stopped"
msgstr "Geldituta"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blob-ak gorde dira"

#: src/window.py:845
msgid "Device Restored"
msgstr "Gailua leheneratuta"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Gailua berrabiaraziko da eta konfigurazio-laguntzailea erakutsiko du."

#: src/window.py:849
msgid "Device Updated"
msgstr "Gailua eguneratuta"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Gailua berrabiaraziko da eguneratzea amaitzen denean."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Ezin izan dira SHSH blob-ak gorde"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Leheneratzeak huts egin du"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Egiaztatu erregistroa xehetasunetarako."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Ez da gailua aurkitu. Konektatu berriro eta saiatu berriro"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Gailua berrabiarazten ari da"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Ezin izan da berreskuratze-modutik irten"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Gailua berreskuratze-moduan berrabiarazten ari da"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
