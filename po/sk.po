#: src/window.py:149
msgid "Apple Device"
msgstr "Zariadenie Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer potrebuje oprávnenie na prístup k tomuto zariadeniu cez USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Nastaviť"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Systémová služba zariadení (usbmuxd) neodpovedá"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Reštartovať"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Služba zariadení (usbmuxd) nie je dostupná"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Prístup cez USB bol nastavený"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Služba zariadení bola reštartovaná"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Reštartovanie zlyhalo. Spustite v termináli „sudo systemctl restart usbmuxd“"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Ručné nastavenie prístupu cez USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Nastavenie sa nepodarilo dokončiť. Spustite v termináli tieto príkazy, ktoré"
" nainštalujú pravidlo prístupu k zariadeniu, a potom zariadenie znova "
"pripojte."

#: src/window.py:301
msgid "_Close"
msgstr "_Zavrieť"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopírovať príkazy"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Hľadajú sa dostupné verzie…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Vyberte súbor firmvéru pre toto zariadenie"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Pre toto zariadenie momentálne nie je podpísaný žiadny firmvér"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Používa sa súbor firmvéru"

#: src/window.py:422
msgid "Downloaded"
msgstr "Stiahnuté"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Stiahnutie {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Offline – zobrazuje sa stiahnutý firmvér"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Použiť súbor IPSW z tohto počítača"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "Súbor {filename} nie je kompatibilný s týmto zariadením"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Vymazať a obnoviť"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Aktualizovať"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Ukončiť _režim obnovy"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Spustiť _režim obnovy"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Súbory firmvéru"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Vybrať súbor firmvéru"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Tento súbor nie je možné použiť"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Vymazať „{name}“?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Všetok obsah a nastavenia budú natrvalo vymazané a nainštaluje sa {version}."
" Túto akciu nie je možné vrátiť späť."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Aktualizovať „{name}“?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Nainštaluje sa {version} a váš obsah a nastavenia zostanú zachované. Pred "
"pokračovaním sa uistite, že máte zálohu."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Táto verzia je staršia ako verzia v zariadení. Prechod na staršiu verziu bez"
" vymazania pravdepodobne zlyhá a môže spôsobiť úplnú stratu dát."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Tento firmvér už zrejme nie je podpísaný, takže ho zariadenie pravdepodobne "
"odmietne."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Nechajte zariadenie pripojené, kým proces neskončí."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Prebieha obnova zariadenia"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Overuje sa firmvér"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Sťahuje sa firmvér"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} z {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Zastaviť proces?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Prerušenie teraz môže spôsobiť, že zariadenie bude nepoužiteľné, kým sa "
"znova neobnoví."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Pokračovať"

#: src/window.py:789
msgid "_Stop"
msgstr "_Zastaviť"

#: src/window.py:807
msgid "Stopping…"
msgstr "Zastavuje sa…"

#: src/window.py:839
msgid "Stopped"
msgstr "Zastavené"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Blobs SHSH uložené"

#: src/window.py:845
msgid "Device Restored"
msgstr "Zariadenie obnovené"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Zariadenie sa reštartuje a zobrazí asistenta nastavenia."

#: src/window.py:849
msgid "Device Updated"
msgstr "Zariadenie aktualizované"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Zariadenie sa po dokončení aktualizácie reštartuje."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Blobs SHSH sa nepodarilo uložiť"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Obnova zlyhala"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Podrobnosti nájdete v zázname."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Zariadenie sa nenašlo. Znova ho pripojte a skúste to ešte raz"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Zariadenie sa reštartuje"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Z režimu obnovy sa nepodarilo vystúpiť"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Zariadenie sa reštartuje do režimu obnovy"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Do režimu obnovy sa nepodarilo vstúpiť. Odomknite zariadenie a dôverujte "
"tomuto počítaču"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Zastaviť a ukončiť?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Prebieha obnova zariadenia. Prerušenie teraz môže spôsobiť, že bude "
"nepoužiteľné, kým sa znova neobnoví."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Zastaviť a ukončiť"

