msgid "Could not load the list of available versions"
msgstr "Saadaolevate versioonide loendit ei õnnestunud laadida"

#: src/firmware.py:185
msgid "This is not a valid firmware file"
msgstr "See ei ole kehtiv püsivara fail"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "See püsivara ei ole allalaadimiseks saadaval"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Püsivara allalaadimiseks pole kettal piisavalt vaba ruumi"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Allalaadimisserver lükkas päringu tagasi"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Allalaadimine ebaõnnestus. Kontrollige oma võrguühendust"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Allalaaditud püsivara on poolik"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Allalaaditud püsivara on rikutud"

#: src/log_dialog.py:16
msgid "Log"
msgstr "Logi"

#: src/log_dialog.py:24
msgid "Copy"
msgstr "Kopeeri"

#: src/log_dialog.py:28
msgid "Save…"
msgstr "Salvesta…"

#: src/log_dialog.py:36
msgid "No Log Yet"
msgstr "Logi veel puudub"

#: src/log_dialog.py:37
msgid "Output appears here when a device is restored."
msgstr "Väljund kuvatakse siin, kui seadet taastatakse."

