msgstr "{done} de {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Parar o processo?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Interromper agora pode deixar o dispositivo inutilizável até que ele seja "
"restaurado novamente."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continuar"

#: src/window.py:789
