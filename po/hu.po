#: src/preferences.py:67
msgid "_Ignore Errors"
msgstr "_Hibák figyelmen kívül hagyása"

#: src/preferences.py:68
msgid "Try to continue after certain errors, like a failed baseband update"
msgstr ""
"Megpróbálja folytatni bizonyos hibák után, például sikertelen baseband-"
"frissítés esetén"

#: src/preferences.py:71
msgid "Skip _Baseband"
msgstr "_Baseband kihagyása"

#: src/preferences.py:72
msgid "Do not upgrade NOR and baseband on legacy devices"
msgstr "A NOR és a baseband ne legyen frissítve régebbi eszközökön"

#: src/preferences.py:74
msgid "_Stop After Ramdisk"
msgstr "_Megállás a ramdisk után"

#: src/preferences.py:75
