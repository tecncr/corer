#. Firmware
#: src/preferences.py:23 src/preferences.py:77
msgid "Firmware"
msgstr "ஃபார்ம்வேர்"

#: src/preferences.py:28
msgid "Downloads"
msgstr "பதிவிறக்கங்கள்"

#: src/preferences.py:29
msgid ""
"Downloaded firmware is stored so that it does not have to be downloaded "
"again."
msgstr ""
"பதிவிறக்கிய ஃபார்ம்வேர் மீண்டும் பதிவிறக்க வேண்டியதில்லை என்பதற்காகச் "
"சேமிக்கப்படுகிறது."

#: src/preferences.py:33
msgid "_Keep Downloaded Firmware"
msgstr "பதிவிறக்கிய ஃபார்ம்வேரை _வைத்திரு"

#: src/preferences.py:34
msgid "Turn off to delete firmware after a successful restore"
msgstr "வெற்றிகரமான மீட்டமைப்புக்குப் பிறகு ஃபார்ம்வேரை நீக்க முடக்கவும்"

#: src/preferences.py:36
msgid "Stored Firmware"
msgstr "சேமிக்கப்பட்ட ஃபார்ம்வேர்"

#: src/preferences.py:37
msgid "Calculating…"
msgstr "கணக்கிடுகிறது…"

#: src/preferences.py:39 src/preferences.py:96
msgid "Open Folder"
msgstr "கோப்புறையைத் திற"

#: src/preferences.py:44 src/preferences.py:145
msgid "_Delete"
msgstr "_நீக்கு"

#. Advanced
#: src/preferences.py:54
msgid "Advanced"
msgstr "மேம்பட்டவை"

#: src/preferences.py:59
msgid "Restore"
msgstr "மீட்டமை"

#: src/preferences.py:60
msgid ""
"These options can leave a device unable to start. Change them only if you "
"know what they do."
msgstr ""
"இந்த விருப்பங்கள் சாதனம் தொடங்காமல் போகச் செய்யலாம். அவை என்ன செய்கின்றன "
"என்று தெரிந்தால் மட்டுமே மாற்றவும்."

#: src/preferences.py:64
msgid "Restore From _Restore Mode"
msgstr "_மீட்டமைப்பு பயன்முறையிலிருந்து மீட்டமை"

#: src/preferences.py:65
msgid "Allow starting with a device that is already in restore mode"
msgstr ""
"ஏற்கனவே மீட்டமைப்பு பயன்முறையில் உள்ள சாதனத்துடன் தொடங்க அனுமதிக்கிறது"

#: src/preferences.py:67
msgid "_Ignore Errors"
msgstr "பிழைகளைப் _புறக்கணி"

#: src/preferences.py:68
msgid "Try to continue after certain errors, like a failed baseband update"
msgstr ""
"baseband புதுப்பிப்பு தோல்வியடைவது போன்ற சில பிழைகளுக்குப் பிறகும் தொடர "
"முயல்கிறது"

#: src/preferences.py:71
msgid "Skip _Baseband"
msgstr "_baseband-ஐத் தவிர்"

#: src/preferences.py:72
msgid "Do not upgrade NOR and baseband on legacy devices"
msgstr "பழைய சாதனங்களில் NOR மற்றும் baseband-ஐ மேம்படுத்தாதே"

#: src/preferences.py:74
msgid "_Stop After Ramdisk"
msgstr "ramdisk-க்குப் பிறகு _நிறுத்து"

#: src/preferences.py:75
msgid "Boot the restore ramdisk without restoring"
msgstr "மீட்டமைக்காமல் மீட்டமைப்பு ramdisk-ஐ துவக்குகிறது"

#: src/preferences.py:80
msgid "_Custom Firmware"
msgstr "_தனிப்பயன் ஃபார்ம்வேர்"

#: src/preferences.py:81
msgid "Restore custom firmware. Requires a bootrom exploit"
msgstr "தனிப்பயன் ஃபார்ம்வேரை மீட்டமைக்கிறது. bootrom எக்ஸ்ப்ளாய்ட் தேவை"

#: src/preferences.py:82
msgid "Restore _Variant"
msgstr "மீட்டமைப்பு _மாறுபாடு"

#: src/preferences.py:83
msgid "Signing Server _URL"
msgstr "கையொப்ப சேவையக _URL"

#: src/preferences.py:86
msgid "Troubleshooting"
msgstr "சிக்கல் தீர்வு"

#: src/preferences.py:89
msgid "_Detailed Log"
msgstr "_விரிவான பதிவு"

#: src/preferences.py:90
msgid "Include all debugging output from idevicerestore in the log"
msgstr "idevicerestore-இன் அனைத்து பிழைத்திருத்த வெளியீட்டையும் பதிவில் சேர்"

#: src/preferences.py:92
msgid "Log Files"
msgstr "பதிவுக் கோப்புகள்"

#: src/preferences.py:93
msgid "Every restore is recorded, even if Corer quits unexpectedly"
msgstr ""
"Corer எதிர்பாராமல் மூடப்பட்டாலும் ஒவ்வொரு மீட்டமைப்பும் பதிவு செய்யப்படும்"

#: src/preferences.py:103
msgid "Keep _Personalized Components"
msgstr "தனிப்பயனாக்கப்பட்ட _கூறுகளை வைத்திரு"

#: src/preferences.py:104
msgid "Write personalized components to files for debugging"
msgstr ""
"பிழைத்திருத்தத்திற்காக தனிப்பயனாக்கப்பட்ட கூறுகளை கோப்புகளில் எழுதுகிறது"

#: src/preferences.py:141
msgid "Delete Stored Firmware?"
msgstr "சேமிக்கப்பட்ட ஃபார்ம்வேரை நீக்கவா?"

