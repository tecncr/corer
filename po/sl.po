msgid "Downloads"
msgstr "Prenosi"

#: src/preferences.py:29
msgid ""
"Downloaded firmware is stored so that it does not have to be downloaded "
"again."
msgstr "Preneseni firmware se shrani, da ga ni treba znova prenašati."

#: src/preferences.py:33
msgid "_Keep Downloaded Firmware"
msgstr "_Ohrani prenesen firmware"

#: src/preferences.py:34
msgid "Turn off to delete firmware after a successful restore"
msgstr "Izklopite, če želite firmware po uspešni obnovitvi izbrisati"

#: src/preferences.py:36
msgid "Stored Firmware"
msgstr "Shranjen firmware"

#: src/preferences.py:37
msgid "Calculating…"
msgstr "Izračunavanje …"

