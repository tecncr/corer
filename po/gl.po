msgstr "_Reiniciar"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "O servizo de dispositivos (usbmuxd) non está dispoñible"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Configurouse o acceso por USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Reiniciouse o servizo de dispositivos"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Non foi posible reiniciar. Execute «sudo systemctl restart usbmuxd» nun "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Configurar manualmente o acceso por USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Non foi posible completar a configuración. Execute estas ordes nun terminal "
"para instalar a regra de acceso ao dispositivo e logo volva conectalo."

#: src/window.py:301
msgid "_Close"
msgstr "_Pechar"

#: src/window.py:302
