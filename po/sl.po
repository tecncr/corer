#. Advanced
#: src/preferences.py:54
msgid "Advanced"
msgstr "Napredno"

#: src/preferences.py:59
msgid "Restore"
msgstr "Obnovitev"

#: src/preferences.py:60
msgid ""
"These options can leave a device unable to start. Change them only if you "
"know what they do."
msgstr ""
"Te možnosti lahko povzročijo, da se naprava ne bo zagnala. Spreminjajte jih "
"le, če veste, kaj počnejo."

#: src/preferences.py:64
msgid "Restore From _Restore Mode"
msgstr "Obnovi iz _obnovitvenega načina"

#: src/preferences.py:65
msgid "Allow starting with a device that is already in restore mode"
msgstr "Omogoči začetek z napravo, ki je že v obnovitvenem načinu"

#: src/preferences.py:67
msgid "_Ignore Errors"
msgstr "_Prezri napake"

#: src/preferences.py:68
msgid "Try to continue after certain errors, like a failed baseband update"
msgstr ""
"Poskusi nadaljevati po nekaterih napakah, kot je neuspela posodobitev "
"baseband"

#: src/preferences.py:71
msgid "Skip _Baseband"
msgstr "Preskoči _baseband"

#: src/preferences.py:72
msgid "Do not upgrade NOR and baseband on legacy devices"
msgstr "Ne nadgrajuj NOR in baseband na starejših napravah"

#: src/preferences.py:74
msgid "_Stop After Ramdisk"
msgstr "_Ustavi po ramdisku"

#: src/preferences.py:75
msgid "Boot the restore ramdisk without restoring"
msgstr "Zažene obnovitveni ramdisk brez obnavljanja"

#: src/preferences.py:80
msgid "_Custom Firmware"
msgstr "_Lasten firmware"

#: src/preferences.py:81
msgid "Restore custom firmware. Requires a bootrom exploit"
msgstr "Obnovi lasten firmware. Zahteva izkoriščanje ranljivosti bootrom"

#: src/preferences.py:82
msgid "Restore _Variant"
msgstr "_Različica obnovitve"

#: src/preferences.py:83
msgid "Signing Server _URL"
msgstr "_URL strežnika za podpisovanje"

#: src/preferences.py:86
msgid "Troubleshooting"
msgstr "Odpravljanje težav"

#: src/preferences.py:89
msgid "_Detailed Log"
msgstr "_Podroben dnevnik"

#: src/preferences.py:90
msgid "Include all debugging output from idevicerestore in the log"
msgstr "V dnevnik vključi ves izpis idevicerestore za razhroščevanje"

#: src/preferences.py:92
msgid "Log Files"
msgstr "Dnevniške datoteke"

#: src/preferences.py:93
msgid "Every restore is recorded, even if Corer quits unexpectedly"
msgstr "Vsaka obnovitev je zabeležena, tudi če se Corer nepričakovano zapre"

#: src/preferences.py:103
msgid "Keep _Personalized Components"
msgstr "Ohrani _prilagojene komponente"

#: src/preferences.py:104
msgid "Write personalized components to files for debugging"
msgstr "Prilagojene komponente zapiše v datoteke za razhroščevanje"

#: src/preferences.py:141
msgid "Delete Stored Firmware?"
msgstr "Želite izbrisati shranjen firmware?"

#: src/preferences.py:142
msgid "Firmware will be downloaded again the next time it is needed."
msgstr "Firmware bo ob naslednji potrebi znova prenesen."

#: src/preferences.py:144 src/window.py:585 src/window.ui:322
msgid "_Cancel"
msgstr "_Prekliči"

#: src/restore.py:27
