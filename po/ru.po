#: src/window.py:149
msgid "Apple Device"
msgstr "Устройство Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer требуется разрешение на доступ к этому устройству через USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Настроить"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Системная служба устройств (usbmuxd) не отвечает"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Перезапустить"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Служба устройств (usbmuxd) недоступна"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Доступ по USB настроен"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Служба устройств перезапущена"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Не удалось перезапустить. Выполните «sudo systemctl restart usbmuxd» в "
"терминале"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Настроить доступ по USB вручную"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Не удалось завершить настройку. Выполните эти команды в терминале, чтобы "
"установить правило доступа к устройству, а затем переподключите устройство."

#: src/window.py:301
msgid "_Close"
msgstr "_Закрыть"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Копировать команды"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Поиск доступных версий…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Выберите файл прошивки для этого устройства"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Для этого устройства сейчас нет подписанной прошивки"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Используется файл прошивки"

#: src/window.py:422
msgid "Downloaded"
msgstr "Загружено"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Загрузка {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Не в сети — показана загруженная прошивка"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Использовать файл IPSW с этого компьютера"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} несовместим с этим устройством"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Стереть и восстановить"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Обновить"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Выйти из _режима восстановления"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Войти в _режим восстановления"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Файлы прошивки"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Выбрать файл прошивки"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Этот файл нельзя использовать"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Стереть «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Всё содержимое и все настройки будут безвозвратно стёрты, и будет "
"установлена {version}. Это действие нельзя отменить."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Обновить «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Будет установлена {version}, а ваше содержимое и настройки сохранятся. Перед"
" продолжением убедитесь, что у вас есть резервная копия."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Эта версия старше версии на устройстве. Откат без стирания, скорее всего, "
"завершится неудачей и может привести к полной потере данных."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Похоже, эта прошивка больше не подписывается, поэтому устройство, скорее "
"всего, отклонит её."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Не отключайте устройство, пока процесс не завершится."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Устройство восстанавливается"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Проверка прошивки"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Загрузка прошивки"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} из {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/с"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Остановить процесс?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Прерывание сейчас может сделать устройство непригодным к использованию, пока"
" оно не будет восстановлено снова."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Продолжить"

#: src/window.py:789
msgid "_Stop"
msgstr "_Остановить"

#: src/window.py:807
msgid "Stopping…"
msgstr "Остановка…"

#: src/window.py:839
msgid "Stopped"
msgstr "Остановлено"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobs сохранены"

#: src/window.py:845
msgid "Device Restored"
msgstr "Устройство восстановлено"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Устройство перезагрузится и покажет ассистент настройки."

#: src/window.py:849
msgid "Device Updated"
msgstr "Устройство обновлено"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Устройство перезагрузится после завершения обновления."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Не удалось сохранить SHSH blobs"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Не удалось восстановить"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Подробности смотрите в журнале."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Устройство не найдено. Переподключите его и повторите попытку"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Устройство перезагружается"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Не удалось выйти из режима восстановления"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Устройство перезагружается в режиме восстановления"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Не удалось войти в режим восстановления. Разблокируйте устройство и "
"доверьтесь этому компьютеру"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Остановить и выйти?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Устройство восстанавливается. Прерывание сейчас может сделать его "
"непригодным к использованию, пока оно не будет восстановлено снова."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Остановить и выйти"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Главное меню"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Подключите устройство"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Подключите устройство Apple USB-кабелем. Устройства в режиме восстановления "
"или DFU тоже подходят. Mac с чипом Apple должен находиться в режиме DFU."

