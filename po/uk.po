msgstr "Пристрій Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer потрібен дозвіл на доступ до цього пристрою через USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Налаштувати"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Системна служба пристроїв (usbmuxd) не відповідає"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Перезапустити"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Служба пристроїв (usbmuxd) недоступна"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Доступ через USB налаштовано"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Службу пристроїв перезапущено"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Не вдалося перезапустити. Виконайте «sudo systemctl restart usbmuxd» у "
"терміналі"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Налаштувати доступ через USB вручну"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Не вдалося завершити налаштування. Виконайте ці команди в терміналі, щоб "
"встановити правило доступу до пристрою, а потім повторно підключіть "
"пристрій."

