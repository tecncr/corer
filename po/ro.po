#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr ""
"Corer are nevoie de permisiune pentru a accesa acest dispozitiv prin USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Configurează"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Serviciul de dispozitive al sistemului (usbmuxd) nu răspunde"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Repornește"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Serviciul de dispozitive (usbmuxd) nu este disponibil"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Accesul USB a fost configurat"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Serviciul de dispozitive a fost repornit"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Nu a putut fi repornit. Rulați „sudo systemctl restart usbmuxd” într-un "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Configurează manual accesul USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Configurarea nu a putut fi finalizată. Rulați aceste comenzi într-un "
"terminal pentru a instala regula de acces la dispozitiv, apoi reconectați "
"dispozitivul."

