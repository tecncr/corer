#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr ""
"Corer heeft toestemming nodig om via USB toegang te krijgen tot dit apparaat"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Instellen"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "De apparaatservice van het systeem (usbmuxd) reageert niet"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Herstarten"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "De apparaatservice (usbmuxd) is niet beschikbaar"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB-toegang is ingesteld"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "De apparaatservice is herstart"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Herstarten is niet gelukt. Voer ‘sudo systemctl restart usbmuxd’ uit in een "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "USB-toegang handmatig instellen"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"De installatie kon niet worden voltooid. Voer deze opdrachten uit in een "
"terminal om de regel voor apparaattoegang te installeren en sluit het "
"apparaat daarna opnieuw aan."

#: src/window.py:301
msgid "_Close"
msgstr "_Sluiten"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "Opdrachten _kopiëren"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Zoeken naar beschikbare versies…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Kies een firmwarebestand voor dit apparaat"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Er is momenteel geen firmware ondertekend voor dit apparaat"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Het firmwarebestand gebruiken"

#: src/window.py:422
msgid "Downloaded"
msgstr "Gedownload"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} downloaden"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Offline — gedownloade firmware wordt getoond"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Een IPSW-bestand van deze computer gebruiken"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} is niet compatibel met dit apparaat"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Wissen en herstellen"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Bijwerken"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "_Herstelmodus verlaten"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_Herstelmodus starten"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Firmwarebestanden"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Firmwarebestand kiezen"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Dit bestand kan niet worden gebruikt"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "‘{name}’ wissen?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Alle inhoud en instellingen worden definitief gewist en {version} wordt "
"geïnstalleerd. Dit kan niet ongedaan worden gemaakt."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "‘{name}’ bijwerken?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} wordt geïnstalleerd en uw inhoud en instellingen blijven behouden."
" Zorg dat u een back-up hebt voordat u doorgaat."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Deze versie is ouder dan die op het apparaat. Downgraden zonder te wissen "
"mislukt waarschijnlijk en kan leiden tot volledig gegevensverlies."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Deze firmware lijkt niet meer ondertekend te zijn, dus het apparaat zal deze"
" waarschijnlijk weigeren."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Houd het apparaat aangesloten totdat het proces is voltooid."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Een apparaat wordt hersteld"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Firmware verifiëren"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Firmware downloaden"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} van {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Het proces stoppen?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Onderbreken kan het apparaat onbruikbaar maken totdat het opnieuw wordt "
"hersteld."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Doorgaan"

#: src/window.py:789
msgid "_Stop"
msgstr "_Stoppen"

#: src/window.py:807
msgid "Stopping…"
msgstr "Stoppen…"

#: src/window.py:839
msgid "Stopped"
msgstr "Gestopt"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH-blobs opgeslagen"

#: src/window.py:845
msgid "Device Restored"
msgstr "Apparaat hersteld"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Het apparaat wordt herstart en toont de configuratie-assistent."

#: src/window.py:849
msgid "Device Updated"
msgstr "Apparaat bijgewerkt"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Het apparaat wordt herstart wanneer het bijwerken is voltooid."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH-blobs konden niet worden opgeslagen"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Herstel mislukt"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Raadpleeg het logboek voor details."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr ""
"Het apparaat is niet gevonden. Sluit het opnieuw aan en probeer het opnieuw"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Het apparaat wordt herstart"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Kon herstelmodus niet verlaten"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Het apparaat wordt herstart in herstelmodus"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Kon herstelmodus niet starten. Ontgrendel het apparaat en vertrouw deze "
"computer"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Stoppen en afsluiten?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Een apparaat wordt hersteld. Onderbreken kan het onbruikbaar maken totdat "
"het opnieuw wordt hersteld."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Stoppen en afsluiten"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Hoofdmenu"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Een apparaat aansluiten"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Sluit een Apple-apparaat aan met een USB-kabel. Apparaten in herstel- of "
"DFU-modus werken ook. Een Mac met Apple silicon moet in DFU-modus staan."

#: src/window.ui:124
msgid "Device"
msgstr "Apparaat"

#: src/window.ui:131
msgid "Version"
msgstr "Versie"

#: src/window.ui:145
msgid "Try Again"
msgstr "Opnieuw proberen"

#: src/window.ui:156
msgid "Firmware File"
msgstr "Firmwarebestand"

