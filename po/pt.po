#: src/window.py:807
msgid "Stopping…"
msgstr "A parar…"

#: src/window.py:839
msgid "Stopped"
msgstr "Parado"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobs guardados"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispositivo restaurado"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "O dispositivo irá reiniciar e mostrar o assistente de configuração."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispositivo atualizado"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "O dispositivo irá reiniciar quando terminar a atualização."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Não foi possível guardar os SHSH blobs"

#: src/window.py:859
msgid "Restore Failed"
msgstr "A restauração falhou"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consulte o registo para obter detalhes."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "O dispositivo não foi encontrado. Volte a ligá-lo e tente novamente"

#: src/window.py:925
msgid "The device is restarting"
msgstr "O dispositivo está a reiniciar"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Não foi possível sair do modo de recuperação"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "O dispositivo está a reiniciar em modo de recuperação"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Não foi possível entrar no modo de recuperação. Desbloqueie o dispositivo e "
"confie neste computador"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Parar e sair?"

