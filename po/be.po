#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Прылада не знойдзена. Падключыце яе паўторна і паспрабуйце зноў"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Прылада перазапускаецца"

#: src/window.py:926
