msgid "_Update"
msgstr "_Atualizar"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Sair do modo de _recuperação"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Entrar no modo de _recuperação"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Arquivos de firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Escolher arquivo de firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Este arquivo não pode ser usado"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Apagar “{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Todo o conteúdo e as configurações serão apagados permanentemente e o "
"{version} será instalado. Esta ação não pode ser desfeita."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Atualizar “{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"O {version} será instalado e seu conteúdo e suas configurações serão "
"mantidos. Certifique-se de ter um backup antes de continuar."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Esta versão é mais antiga que a do dispositivo. Fazer downgrade sem apagar "
"provavelmente falhará e pode causar a perda total dos dados."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Este firmware parece não estar mais assinado, então o dispositivo "
"provavelmente irá recusá-lo."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Mantenha o dispositivo conectado até o processo terminar."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Um dispositivo está sendo restaurado"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Verificando o firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Baixando o firmware"

