#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer'ın bu aygıta USB üzerinden erişmek için izne ihtiyacı var"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Kur"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Sistem aygıt hizmeti (usbmuxd) yanıt vermiyor"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Yeniden Başlat"

#: src/window.py:229
