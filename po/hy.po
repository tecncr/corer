msgstr "Սարքը վերականգնվեց"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Սարքը կվերագործարկվի և կցուցադրի կարգավորման օգնականը։"

#: src/window.py:849
msgid "Device Updated"
msgstr "Սարքը թարմացվեց"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Սարքը կվերագործարկվի թարմացումն ավարտվելուն պես։"

