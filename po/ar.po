msgid "_Erase and Restore"
msgstr "_محو واستعادة"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_تحديث"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "الخروج من _وضع الاسترداد"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "الدخول في _وضع الاسترداد"

#: src/window.py:502
msgid "Firmware Files"
msgstr "ملفات البرنامج الثابت"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "اختيار ملف البرنامج الثابت"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "لا يمكن استخدام هذا الملف"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "هل تريد محو «{name}»؟"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"سيُمحى كل المحتوى والإعدادات نهائيًا وسيُثبَّت {version}. لا يمكن التراجع عن"
" هذا الإجراء."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "هل تريد تحديث «{name}»؟"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"سيُثبَّت {version} وسيُحتفظ بمحتواك وإعداداتك. تأكد من وجود نسخة احتياطية "
"قبل المتابعة."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"هذا الإصدار أقدم من الإصدار الموجود على الجهاز. من المرجّح أن يفشل الرجوع "
"إلى إصدار أقدم دون محو، وقد يتسبب في فقدان كامل للبيانات."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"يبدو أن هذا البرنامج الثابت لم يعد موقَّعًا، لذا من المرجّح أن يرفضه الجهاز."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "أبقِ الجهاز متصلًا حتى تنتهي العملية."

#: src/window.py:628
msgid "A device is being restored"
msgstr "جارٍ استعادة جهاز"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "جارٍ التحقق من البرنامج الثابت"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "جارٍ تنزيل البرنامج الثابت"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} من {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/ث"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "هل تريد إيقاف العملية؟"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"قد تجعل المقاطعة الآن الجهاز غير قابل للاستخدام إلى أن تتم استعادته مرة "
"أخرى."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_متابعة"

#: src/window.py:789
msgid "_Stop"
msgstr "_إيقاف"

#: src/window.py:807
msgid "Stopping…"
msgstr "جارٍ الإيقاف…"

#: src/window.py:839
msgid "Stopped"
msgstr "أُوقف"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "حُفظت SHSH blobs"

#: src/window.py:845
msgid "Device Restored"
msgstr "تمت استعادة الجهاز"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "سيُعاد تشغيل الجهاز ويعرض مساعد الإعداد."

#: src/window.py:849
msgid "Device Updated"
msgstr "تم تحديث الجهاز"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "سيُعاد تشغيل الجهاز عند انتهاء التحديث."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "تعذّر حفظ SHSH blobs"

#: src/window.py:859
msgid "Restore Failed"
msgstr "فشلت الاستعادة"

#: src/window.py:863
msgid "Check the log for details."
msgstr "راجع السجل لمعرفة التفاصيل."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "لم يُعثر على الجهاز. أعد توصيله وحاول مرة أخرى"

#: src/window.py:925
msgid "The device is restarting"
msgstr "الجهاز يُعاد تشغيله"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "تعذّر الخروج من وضع الاسترداد"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "الجهاز يُعاد تشغيله في وضع الاسترداد"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr "تعذّر الدخول في وضع الاسترداد. افتح قفل الجهاز وثق بهذا الحاسوب"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "هل تريد الإيقاف والخروج؟"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"جارٍ استعادة جهاز. قد تجعله المقاطعة الآن غير قابل للاستخدام إلى أن تتم "
"استعادته مرة أخرى."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_إيقاف وخروج"

#: src/window.ui:21
msgid "Main Menu"
msgstr "القائمة الرئيسية"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "وصل جهاز"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"صِل جهاز Apple بكبل USB. تعمل أيضًا الأجهزة في وضع الاسترداد أو DFU. يجب أن "
"يكون Mac المزوّد بشريحة Apple في وضع DFU."

