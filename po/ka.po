msgid "Set Up USB Access Manually"
msgstr "USB-ით წვდომის ხელით მორგება"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"მორგების დასრულება ვერ მოხერხდა. მოწყობილობაზე წვდომის წესის დასაყენებლად "
"ტერმინალში გაუშვით ეს ბრძანებები, შემდეგ კი მოწყობილობა ხელახლა შეაერთეთ."

#: src/window.py:301
msgid "_Close"
msgstr "_დახურვა"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "ბრძანებების _კოპირება"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "ხელმისაწვდომი ვერსიების ძიება…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "აირჩიეთ ფირმვეარის ფაილი ამ მოწყობილობისთვის"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "ამ მოწყობილობისთვის ამჟამად ხელმოწერილი ფირმვეარი არ არსებობს"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "გამოიყენება ფირმვეარის ფაილი"

#: src/window.py:422
msgid "Downloaded"
msgstr "ჩამოტვირთულია"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} ჩამოტვირთვა"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "ხაზგარეშე — ნაჩვენებია ჩამოტვირთული ფირმვეარი"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "ამ კომპიუტერის IPSW ფაილის გამოყენება"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} ამ მოწყობილობასთან თავსებადი არ არის"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_წაშლა და აღდგენა"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_განახლება"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "გასვლა _აღდგენის რეჟიმიდან"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_აღდგენის რეჟიმში შესვლა"

#: src/window.py:502
msgid "Firmware Files"
msgstr "ფირმვეარის ფაილები"

