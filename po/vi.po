msgstr "Tải về {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Ngoại tuyến — đang hiện firmware đã tải về"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Dùng tệp IPSW từ máy tính này"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} không tương thích với thiết bị này"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Xóa và khôi phục"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Cập nhật"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Thoát _chế độ khôi phục"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Vào _chế độ khôi phục"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Tệp firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Chọn tệp firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Không thể dùng tệp này"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Xóa “{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Toàn bộ nội dung và cài đặt sẽ bị xóa vĩnh viễn và {version} sẽ được cài "
"đặt. Không thể hoàn tác thao tác này."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Cập nhật “{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} sẽ được cài đặt và nội dung cùng cài đặt của bạn sẽ được giữ lại. "
"Hãy chắc chắn bạn đã có bản sao lưu trước khi tiếp tục."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Phiên bản này cũ hơn phiên bản trên thiết bị. Hạ cấp mà không xóa nhiều khả "
"năng sẽ thất bại và có thể gây mất toàn bộ dữ liệu."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Firmware này dường như không còn được ký, vì vậy thiết bị nhiều khả năng sẽ "
"từ chối nó."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Hãy giữ thiết bị được kết nối cho đến khi quá trình kết thúc."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Một thiết bị đang được khôi phục"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Đang xác minh firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Đang tải firmware"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
