msgstr "已設定 USB 存取"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "裝置服務已重新啟動"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr "無法重新啟動。請在終端機中執行「sudo systemctl restart usbmuxd」"

