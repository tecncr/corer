msgid "Corer needs permission to access this device over USB"
msgstr ""
"Corer benötigt die Berechtigung, über USB auf dieses Gerät zuzugreifen"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Einrichten"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Der Gerätedienst des Systems (usbmuxd) antwortet nicht"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Neu starten"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Der Gerätedienst (usbmuxd) ist nicht verfügbar"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Der USB-Zugriff wurde eingerichtet"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Der Gerätedienst wurde neu gestartet"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Neustart nicht möglich. Führen Sie „sudo systemctl restart usbmuxd“ in einem"
" Terminal aus"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "USB-Zugriff manuell einrichten"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Die Einrichtung konnte nicht abgeschlossen werden. Führen Sie diese Befehle "
"in einem Terminal aus, um die Regel für den Gerätezugriff zu installieren, "
"und verbinden Sie das Gerät anschließend erneut."

