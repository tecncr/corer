msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Չհաջողվեց մտնել վերականգնման ռեժիմ։ Ապակողպեք սարքը և վստահեք այս "
"համակարգչին"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Կանգնեցնե՞լ և դուրս գալ"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Սարք է վերականգնվում։ Հիմա ընդհատելը կարող է այն անգործածելի դարձնել, մինչև "
"նորից վերականգնվի։"

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Կանգնեցնել և դուրս գալ"

