msgstr "استخدام ملف IPSW من هذا الحاسوب"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "الملف {filename} غير متوافق مع هذا الجهاز"

