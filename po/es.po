msgstr "Co_piar las órdenes"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Buscando versiones disponibles…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Elija un archivo de firmware para este dispositivo"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Actualmente no hay ningún firmware firmado para este dispositivo"

#: src/window.py:418
