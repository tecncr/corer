#: src/window.py:149
msgid "Apple Device"
msgstr "Zařízení Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer potřebuje oprávnění k přístupu k tomuto zařízení přes USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Nastavit"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Systémová služba zařízení (usbmuxd) neodpovídá"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Restartovat"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Služba zařízení (usbmuxd) není dostupná"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Přístup přes USB byl nastaven"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Služba zařízení byla restartována"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Restartování se nezdařilo. Spusťte v terminálu „sudo systemctl restart "
"usbmuxd“"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Ruční nastavení přístupu přes USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Nastavení nelze dokončit. Spusťte v terminálu tyto příkazy, které "
"nainstalují pravidlo přístupu k zařízení, a poté zařízení znovu připojte."

