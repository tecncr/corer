#: src/window.py:149
msgid "Apple Device"
msgstr "Apple-laite"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer tarvitsee luvan käyttää tätä laitetta USB:n kautta"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Määritä"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Järjestelmän laitepalvelu (usbmuxd) ei vastaa"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Käynnistä uudelleen"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Laitepalvelu (usbmuxd) ei ole käytettävissä"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB-käyttö määritettiin"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Laitepalvelu käynnistettiin uudelleen"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Uudelleenkäynnistys epäonnistui. Suorita päätteessä ”sudo systemctl restart "
"usbmuxd”"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Määritä USB-käyttö käsin"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Määritystä ei voitu viimeistellä. Suorita nämä komennot päätteessä "
"asentaaksesi laitteen käyttösäännön ja liitä laite sitten uudelleen."

#: src/window.py:301
msgid "_Close"
msgstr "_Sulje"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopioi komennot"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Etsitään saatavilla olevia versioita…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Valitse tälle laitteelle laiteohjelmistotiedosto"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr ""
"Tälle laitteelle ei ole tällä hetkellä allekirjoitettua laiteohjelmistoa"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Käytössä oleva laiteohjelmistotiedosto"

#: src/window.py:422
msgid "Downloaded"
msgstr "Ladattu"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} lataus"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Ei verkossa — näytetään ladattu laiteohjelmisto"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Käytä tämän tietokoneen IPSW-tiedostoa"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} ei ole yhteensopiva tämän laitteen kanssa"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Tyhjennä ja palauta"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Päivitä"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Poistu _palautustilasta"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Siirry _palautustilaan"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Laiteohjelmistotiedostot"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Valitse laiteohjelmistotiedosto"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Tätä tiedostoa ei voi käyttää"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Tyhjennetäänkö ”{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Kaikki sisältö ja asetukset poistetaan pysyvästi ja {version} asennetaan. "
"Tätä ei voi perua."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Päivitetäänkö ”{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} asennetaan ja sisältösi sekä asetuksesi säilytetään. Varmista, "
"että sinulla on varmuuskopio, ennen kuin jatkat."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Tämä versio on laitteessa olevaa vanhempi. Vanhempaan versioon palaaminen "
"tyhjentämättä epäonnistuu todennäköisesti ja voi johtaa kaikkien tietojen "
"menettämiseen."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Tätä laiteohjelmistoa ei näytä enää allekirjoitetun, joten laite "
"todennäköisesti hylkää sen."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Pidä laite liitettynä, kunnes prosessi on valmis."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Laitetta palautetaan"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Vahvistetaan laiteohjelmistoa"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Ladataan laiteohjelmistoa"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Pysäytetäänkö prosessi?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Keskeyttäminen nyt voi jättää laitteen käyttökelvottomaksi, kunnes se "
"palautetaan uudelleen."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Jatka"

#: src/window.py:789
msgid "_Stop"
msgstr "_Pysäytä"

#: src/window.py:807
msgid "Stopping…"
msgstr "Pysäytetään…"

#: src/window.py:839
msgid "Stopped"
msgstr "Pysäytetty"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH-blobit tallennettu"

#: src/window.py:845
msgid "Device Restored"
msgstr "Laite palautettu"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Laite käynnistyy uudelleen ja näyttää asennusavustajan."

#: src/window.py:849
msgid "Device Updated"
msgstr "Laite päivitetty"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Laite käynnistyy uudelleen, kun päivitys on valmis."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH-blobien tallennus epäonnistui"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Palautus epäonnistui"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Katso lisätiedot lokista."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Laitetta ei löytynyt. Liitä se uudelleen ja yritä uudelleen"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Laite käynnistyy uudelleen"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Palautustilasta poistuminen epäonnistui"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Laite käynnistyy uudelleen palautustilassa"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
