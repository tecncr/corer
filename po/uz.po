#: src/shortcuts-dialog.ui:44
msgctxt "shortcut window"
msgid "Quit"
msgstr "Chiqish"

#: src/window.py:149
msgid "Apple Device"
msgstr "Apple qurilmasi"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer’ga bu qurilmaga USB orqali kirish uchun ruxsat kerak"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Sozlash"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Tizim qurilma xizmati (usbmuxd) javob bermayapti"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Qayta ishga tushirish"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Qurilma xizmati (usbmuxd) mavjud emas"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB orqali kirish sozlandi"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Qurilma xizmati qayta ishga tushirildi"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Qayta ishga tushirib boʻlmadi. Terminalda “sudo systemctl restart usbmuxd” "
"buyrugʻini bajaring"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "USB orqali kirishni qoʻlda sozlash"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Sozlashni yakunlab boʻlmadi. Qurilmaga kirish qoidasini oʻrnatish uchun "
"terminalda ushbu buyruqlarni bajaring, soʻng qurilmani qayta ulang."

#: src/window.py:301
msgid "_Close"
msgstr "_Yopish"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "Buyruqlardan _nusxa olish"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Mavjud versiyalar qidirilmoqda…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Ushbu qurilma uchun proshivka faylini tanlang"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Hozirda bu qurilma uchun imzolangan proshivka yoʻq"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Proshivka fayli ishlatilmoqda"

#: src/window.py:422
msgid "Downloaded"
msgstr "Yuklab olingan"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} yuklab olish"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Oflayn — yuklab olingan proshivka koʻrsatilmoqda"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Ushbu kompyuterdagi IPSW faylidan foydalanish"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} ushbu qurilma bilan mos emas"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Oʻchirish va tiklash"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Yangilash"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "_Tiklash rejimidan chiqish"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_Tiklash rejimiga kirish"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Proshivka fayllari"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Proshivka faylini tanlash"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Bu fayldan foydalanib boʻlmaydi"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "“{name}” oʻchirilsinmi?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Barcha kontent va sozlamalar butunlay oʻchiriladi va {version} oʻrnatiladi. "
"Buni bekor qilib boʻlmaydi."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "“{name}” yangilansinmi?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} oʻrnatiladi, kontent va sozlamalaringiz saqlanadi. Davom etishdan "
"oldin zaxira nusxangiz borligiga ishonch hosil qiling."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Bu versiya qurilmadagidan eski. Oʻchirmasdan eski versiyaga qaytish "
"koʻpincha muvaffaqiyatsiz boʻladi va barcha maʼlumotlarning yoʻqolishiga "
"olib kelishi mumkin."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Bu proshivka endi imzolanmaganga oʻxshaydi, shuning uchun qurilma uni rad "
"etishi mumkin."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Jarayon tugaguncha qurilmani ulangan holda qoldiring."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Qurilma tiklanmoqda"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Proshivka tekshirilmoqda"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Proshivka yuklab olinmoqda"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{total} dan {done}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Jarayon toʻxtatilsinmi?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Hozir toʻxtatish qurilmani qayta tiklanmaguncha ishlatib boʻlmaydigan holga "
"keltirishi mumkin."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Davom etish"

#: src/window.py:789
msgid "_Stop"
msgstr "_Toʻxtatish"

#: src/window.py:807
msgid "Stopping…"
msgstr "Toʻxtatilmoqda…"

#: src/window.py:839
msgid "Stopped"
msgstr "Toʻxtatildi"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blob’lar saqlandi"

#: src/window.py:845
msgid "Device Restored"
msgstr "Qurilma tiklandi"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Qurilma qayta ishga tushadi va sozlash yordamchisini koʻrsatadi."

#: src/window.py:849
msgid "Device Updated"
msgstr "Qurilma yangilandi"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Yangilash tugagach, qurilma qayta ishga tushadi."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH blob’larni saqlab boʻlmadi"

#: src/window.py:859
