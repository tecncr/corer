msgid "This is not a valid firmware file"
msgstr "Aquest no és un fitxer de microprogramari vàlid"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Aquest microprogramari no està disponible per baixar"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "No hi ha prou espai lliure al disc per baixar el microprogramari"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "El servidor de baixades ha rebutjat la sol·licitud"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "La baixada ha fallat. Comproveu la connexió de xarxa"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "El microprogramari baixat és incomplet"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "El microprogramari baixat està malmès"

