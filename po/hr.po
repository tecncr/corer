#: src/window.py:149
msgid "Apple Device"
msgstr "Appleov uređaj"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer treba dopuštenje za pristup ovom uređaju putem USB-a"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Postavi"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Sistemska usluga uređaja (usbmuxd) ne odgovara"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Ponovno pokreni"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Usluga uređaja (usbmuxd) nije dostupna"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB pristup je postavljen"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Usluga uređaja je ponovno pokrenuta"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Nije ju moguće ponovno pokrenuti. Pokrenite „sudo systemctl restart usbmuxd”"
" u terminalu"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Ručno postavi USB pristup"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Postavljanje nije moglo biti dovršeno. Pokrenite ove naredbe u terminalu "
"kako biste instalirali pravilo za pristup uređaju, a zatim ponovno povežite "
"uređaj."

#: src/window.py:301
msgid "_Close"
msgstr "_Zatvori"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopiraj naredbe"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Traženje dostupnih verzija…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Odaberite datoteku firmwarea za ovaj uređaj"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Trenutačno nijedan firmware nije potpisan za ovaj uređaj"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Korištenje datoteke firmwarea"

#: src/window.py:422
msgid "Downloaded"
msgstr "Preuzeto"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Preuzimanje: {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Izvan mreže — prikazuje se preuzeti firmware"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Koristi IPSW datoteku s ovog računala"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} nije kompatibilna s ovim uređajem"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Izbriši i vrati"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Ažuriraj"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Izađi iz _načina rada za oporavak"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Uđi u _način rada za oporavak"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Datoteke firmwarea"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Odaberi datoteku firmwarea"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Ova se datoteka ne može koristiti"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Izbrisati „{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Sav sadržaj i sve postavke bit će trajno izbrisani i instalirat će se "
"{version}. Ovo se ne može poništiti."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Ažurirati „{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Instalirat će se {version}, a vaš sadržaj i postavke bit će zadržani. Prije "
"nastavka provjerite imate li sigurnosnu kopiju."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Ova je verzija starija od one na uređaju. Vraćanje na stariju verziju bez "
"brisanja vjerojatno neće uspjeti i može uzrokovati potpuni gubitak podataka."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Čini se da ovaj firmware više nije potpisan pa će ga uređaj vjerojatno "
"odbiti."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Držite uređaj povezanim dok proces ne završi."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Uređaj se vraća"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Provjera firmwarea"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Preuzimanje firmwarea"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} od {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Zaustaviti proces?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Prekid sada može uređaj ostaviti neupotrebljivim dok se ponovno ne vrati."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Nastavi"

#: src/window.py:789
msgid "_Stop"
msgstr "_Zaustavi"

#: src/window.py:807
msgid "Stopping…"
msgstr "Zaustavljanje…"

#: src/window.py:839
msgid "Stopped"
msgstr "Zaustavljeno"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobovi spremljeni"

#: src/window.py:845
msgid "Device Restored"
msgstr "Uređaj je vraćen"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Uređaj će se ponovno pokrenuti i prikazati pomoćnika za postavljanje."

#: src/window.py:849
msgid "Device Updated"
msgstr "Uređaj je ažuriran"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Uređaj će se ponovno pokrenuti kada završi ažuriranje."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Nije moguće spremiti SHSH blobove"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Vraćanje nije uspjelo"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Pojedinosti potražite u zapisniku."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Uređaj nije pronađen. Ponovno ga povežite i pokušajte opet"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Uređaj se ponovno pokreće"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Nije moguće izaći iz načina rada za oporavak"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Uređaj se ponovno pokreće u načinu rada za oporavak"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
