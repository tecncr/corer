#: src/window.py:149
msgid "Apple Device"
msgstr "Apple'i seade"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer vajab luba selle seadme kasutamiseks USB kaudu"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Seadista"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Süsteemi seadmeteenus (usbmuxd) ei vasta"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Taaskäivita see"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Seadmeteenus (usbmuxd) ei ole saadaval"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB-juurdepääs seadistati"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Seadmeteenus taaskäivitati"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Taaskäivitamine ebaõnnestus. Käivitage terminalis „sudo systemctl restart "
"usbmuxd“"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Seadista USB-juurdepääs käsitsi"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Seadistust ei õnnestunud lõpetada. Seadmele juurdepääsu reegli "
"paigaldamiseks käivitage terminalis need käsud ja ühendage seade seejärel "
"uuesti."

#: src/window.py:301
msgid "_Close"
msgstr "_Sulge"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopeeri käsud"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Saadaolevate versioonide otsimine…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Valige sellele seadmele püsivara fail"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Sellele seadmele pole praegu ühtegi allkirjastatud püsivara"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Kasutatav püsivara fail"

#: src/window.py:422
msgid "Downloaded"
msgstr "Allalaaditud"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Allalaadimine: {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Võrguühenduseta — kuvatakse allalaaditud püsivara"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Kasuta selle arvuti IPSW-faili"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} ei ühildu selle seadmega"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Kustuta ja taasta"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Värskenda"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Välju _taasterežiimist"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Sisene _taasterežiimi"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Püsivara failid"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Vali püsivara fail"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Seda faili ei saa kasutada"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Kas kustutada „{name}“?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Kogu sisu ja kõik seaded kustutatakse jäädavalt ning paigaldatakse "
"{version}. Seda ei saa tagasi võtta."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Kas värskendada „{name}“?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Paigaldatakse {version} ning teie sisu ja seaded säilitatakse. Enne "
"jätkamist veenduge, et teil on varukoopia."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"See versioon on seadmes olevast vanem. Vanema versiooni paigaldamine "
"kustutamata on tõenäoliselt ebaõnnestuv ja võib põhjustada andmete täieliku "
"kadumise."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Tundub, et see püsivara ei ole enam allkirjastatud, seega seade lükkab selle"
" tõenäoliselt tagasi."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Hoidke seade ühendatud, kuni protsess lõpeb."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Seadet taastatakse"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Püsivara kontrollimine"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Püsivara allalaadimine"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Kas peatada protsess?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Katkestamine praegu võib muuta seadme kasutuskõlbmatuks, kuni see uuesti "
"taastatakse."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Jätka"

#: src/window.py:789
msgid "_Stop"
msgstr "_Peata"

#: src/window.py:807
msgid "Stopping…"
msgstr "Peatamine…"

#: src/window.py:839
msgid "Stopped"
msgstr "Peatatud"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobid salvestati"

#: src/window.py:845
msgid "Device Restored"
msgstr "Seade taastati"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Seade taaskäivitub ja kuvab seadistusabilise."

#: src/window.py:849
msgid "Device Updated"
msgstr "Seade värskendati"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Seade taaskäivitub, kui värskendamine on lõppenud."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH blobide salvestamine ebaõnnestus"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Taastamine ebaõnnestus"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Üksikasjad leiate logist."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Seadet ei leitud. Ühendage see uuesti ja proovige veel kord"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Seade taaskäivitub"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Taasterežiimist väljumine ebaõnnestus"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Seade taaskäivitub taasterežiimis"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Taasterežiimi sisenemine ebaõnnestus. Avage seadme lukustus ja usaldage seda"
" arvutit"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Kas peatada ja väljuda?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
