msgid "Could not load the list of available versions"
msgstr "Tidak dapat memuat daftar versi yang tersedia"

#: src/firmware.py:185
msgid "This is not a valid firmware file"
msgstr "Ini bukan berkas firmware yang valid"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Firmware ini tidak tersedia untuk diunduh"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Ruang disk kosong tidak cukup untuk mengunduh firmware"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Server unduhan menolak permintaan"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Pengunduhan gagal. Periksa koneksi jaringan Anda"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Firmware yang diunduh tidak lengkap"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Firmware yang diunduh rusak"

