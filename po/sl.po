msgstr "Zaznavanje naprave"

#: src/restore.py:28
msgid "Preparing Device"
msgstr "Priprava naprave"

#: src/restore.py:29
msgid "Sending Filesystem"
msgstr "Pošiljanje datotečnega sistema"

#: src/restore.py:30
msgid "Verifying Filesystem"
msgstr "Preverjanje datotečnega sistema"

#: src/restore.py:31
msgid "Installing Firmware"
msgstr "Nameščanje firmwarea"

#: src/restore.py:32
msgid "Updating Baseband"
msgstr "Posodabljanje baseband"

#: src/restore.py:33
msgid "Updating Components"
msgstr "Posodabljanje komponent"

#: src/restore.py:34
msgid "Sending Images"
msgstr "Pošiljanje slik"

#: src/restore.py:63
msgid "Restoring"
msgstr "Obnavljanje"

#: src/restore.py:134
msgid "idevicerestore could not be started"
msgstr "Zagon idevicerestore ni uspel"

#: src/shortcuts-dialog.ui:6
msgctxt "shortcut window"
msgid "Device"
msgstr "Naprava"

#: src/shortcuts-dialog.ui:9
msgctxt "shortcut window"
msgid "Choose Firmware File"
msgstr "Izberi datoteko firmwarea"

#: src/shortcuts-dialog.ui:15
msgctxt "shortcut window"
msgid "Look for Devices"
msgstr "Poišči naprave"

#: src/shortcuts-dialog.ui:21
msgctxt "shortcut window"
msgid "View Log"
msgstr "Pokaži dnevnik"

#: src/shortcuts-dialog.ui:29
msgctxt "shortcut window"
msgid "General"
msgstr "Splošno"

#: src/shortcuts-dialog.ui:32
msgctxt "shortcut window"
msgid "Preferences"
msgstr "Nastavitve"

#: src/shortcuts-dialog.ui:38
msgctxt "shortcut window"
msgid "Show Shortcuts"
msgstr "Pokaži bližnjice"

#: src/shortcuts-dialog.ui:44
msgctxt "shortcut window"
msgid "Quit"
msgstr "Končaj"

#: src/window.py:149
msgid "Apple Device"
msgstr "Naprava Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer potrebuje dovoljenje za dostop do te naprave prek USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Nastavi"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Sistemska storitev naprav (usbmuxd) se ne odziva"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Znova zaženi"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Storitev naprav (usbmuxd) ni na voljo"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Dostop prek USB je nastavljen"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Storitev naprav je bila znova zagnana"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Ponovni zagon ni uspel. V terminalu zaženite »sudo systemctl restart "
"usbmuxd«"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Ročno nastavi dostop prek USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Nastavitve ni bilo mogoče dokončati. V terminalu zaženite te ukaze, da "
"namestite pravilo za dostop do naprave, nato napravo znova priključite."

#: src/window.py:301
msgid "_Close"
msgstr "_Zapri"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "_Kopiraj ukaze"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Iskanje razpoložljivih različic …"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Izberite datoteko firmwarea za to napravo"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Za to napravo trenutno ni podpisan noben firmware"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Uporaba datoteke firmwarea"

#: src/window.py:422
msgid "Downloaded"
msgstr "Preneseno"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Prenos {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Brez povezave – prikazan je preneseni firmware"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Uporabi datoteko IPSW s tega računalnika"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "Datoteka {filename} ni združljiva s to napravo"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Izbriši in obnovi"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Posodobi"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Izhod iz _obnovitvenega načina"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Vstop v _obnovitveni način"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Datoteke firmwarea"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Izberi datoteko firmwarea"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Te datoteke ni mogoče uporabiti"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Želite izbrisati »{name}«?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Vsa vsebina in nastavitve bodo trajno izbrisane, nameščen pa bo {version}. "
"Tega ni mogoče razveljaviti."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Želite posodobiti »{name}«?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Nameščen bo {version}, vaša vsebina in nastavitve pa bodo ohranjene. Pred "
"nadaljevanjem poskrbite, da imate varnostno kopijo."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Ta različica je starejša od tiste v napravi. Prehod na starejšo različico "
"brez brisanja bo verjetno spodletel in lahko povzroči popolno izgubo "
"podatkov."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Videti je, da ta firmware ni več podpisan, zato ga bo naprava verjetno "
"zavrnila."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Naprave ne odklopite, dokler se postopek ne konča."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Naprava se obnavlja"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Preverjanje firmwarea"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Prenašanje firmwarea"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} od {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Želite ustaviti postopek?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Prekinitev zdaj lahko napravo naredi neuporabno, dokler ni znova obnovljena."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Nadaljuj"

#: src/window.py:789
msgid "_Stop"
msgstr "_Ustavi"

#: src/window.py:807
msgid "Stopping…"
msgstr "Ustavljanje …"

#: src/window.py:839
msgid "Stopped"
msgstr "Ustavljeno"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobi shranjeni"

#: src/window.py:845
msgid "Device Restored"
msgstr "Naprava obnovljena"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Naprava se bo znova zagnala in prikazala pomočnika za nastavitev."

#: src/window.py:849
msgid "Device Updated"
msgstr "Naprava posodobljena"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Naprava se bo znova zagnala, ko bo posodobitev končana."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH blobov ni bilo mogoče shraniti"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Obnovitev ni uspela"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Podrobnosti poiščite v dnevniku."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Naprave ni bilo mogoče najti. Znova jo priključite in poskusite znova"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Naprava se znova zaganja"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Izhod iz obnovitvenega načina ni uspel"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Naprava se znova zaganja v obnovitvenem načinu"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Vstop v obnovitveni način ni uspel. Odklenite napravo in zaupajte temu "
"računalniku"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Želite ustaviti in končati?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
