msgid "USB access was set up"
msgstr "USB-ით წვდომა მოირგო"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "მოწყობილობების სერვისი გადაიტვირთა"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"გადატვირთვა ვერ მოხერხდა. ტერმინალში გაუშვით „sudo systemctl restart "
