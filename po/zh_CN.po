msgstr "正在验证固件"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "正在下载固件"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/秒"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "停止此过程？"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr "现在中断可能会导致设备无法使用，直到再次恢复。"

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "继续(_C)"

#: src/window.py:789
msgid "_Stop"
msgstr "停止(_S)"

#: src/window.py:807
msgid "Stopping…"
msgstr "正在停止…"

#: src/window.py:839
msgid "Stopped"
msgstr "已停止"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "已保存 SHSH blob"

#: src/window.py:845
msgid "Device Restored"
msgstr "设备已恢复"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "设备将重新启动并显示设置助理。"

#: src/window.py:849
msgid "Device Updated"
msgstr "设备已更新"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "更新完成后，设备将重新启动。"

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "无法保存 SHSH blob"

