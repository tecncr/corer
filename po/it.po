msgstr "Download di {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Non in linea — viene mostrato il firmware scaricato"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Usa un file IPSW di questo computer"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} non è compatibile con questo dispositivo"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Cancella e ripristina"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "A_ggiorna"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Esci dalla modalità di _recupero"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Entra in modalità di _recupero"

#: src/window.py:502
msgid "Firmware Files"
msgstr "File di firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Scegli file di firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Questo file non può essere usato"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Cancellare «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Tutti i contenuti e le impostazioni verranno cancellati definitivamente e "
"verrà installato {version}. Questa operazione non può essere annullata."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Aggiornare «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Verrà installato {version} e i tuoi contenuti e le tue impostazioni saranno "
"conservati. Assicurati di avere un backup prima di continuare."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Questa versione è più vecchia di quella presente sul dispositivo. Il "
"downgrade senza cancellazione probabilmente fallirà e può causare la perdita"
" totale dei dati."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Questo firmware non sembra più essere firmato, quindi il dispositivo "
"probabilmente lo rifiuterà."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Mantieni il dispositivo collegato fino al termine del processo."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Un dispositivo è in fase di ripristino"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Verifica del firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Download del firmware"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} di {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Interrompere il processo?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Un’interruzione ora può rendere il dispositivo inutilizzabile finché non "
"viene ripristinato di nuovo."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continua"

#: src/window.py:789
msgid "_Stop"
msgstr "_Interrompi"

#: src/window.py:807
msgid "Stopping…"
msgstr "Interruzione in corso…"

#: src/window.py:839
msgid "Stopped"
msgstr "Interrotto"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Blob SHSH salvati"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispositivo ripristinato"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr ""
"Il dispositivo verrà riavviato e mostrerà l’assistente di configurazione."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispositivo aggiornato"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Il dispositivo verrà riavviato al termine dell’aggiornamento."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Impossibile salvare i blob SHSH"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Ripristino non riuscito"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consulta il registro per i dettagli."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Dispositivo non trovato. Ricollegalo e riprova"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Il dispositivo si sta riavviando"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Impossibile uscire dalla modalità di recupero"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Il dispositivo si sta riavviando in modalità di recupero"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Impossibile entrare in modalità di recupero. Sblocca il dispositivo e "
"autorizza questo computer"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Interrompere e uscire?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Un dispositivo è in fase di ripristino. Un’interruzione ora può renderlo "
"inutilizzabile finché non viene ripristinato di nuovo."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Interrompi ed esci"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Menù principale"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Collega un dispositivo"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Collega un dispositivo Apple con un cavo USB. Funzionano anche i dispositivi"
" in modalità di recupero o DFU. Un Mac con Apple silicon deve essere in "
"modalità DFU."

