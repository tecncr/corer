#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer זקוק להרשאה כדי לגשת למכשיר זה דרך USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_הגדרה"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "שירות המכשירים של המערכת (usbmuxd) אינו מגיב"

#: src/window.py:224
msgid "_Restart It"
msgstr "_הפעלה מחדש"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "שירות המכשירים (usbmuxd) אינו זמין"

#: src/window.py:260
msgid "USB access was set up"
msgstr "הגישה דרך USB הוגדרה"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "שירות המכשירים הופעל מחדש"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr "לא ניתן היה להפעיל מחדש. הריצו „sudo systemctl restart usbmuxd” במסוף"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "הגדרת גישת USB ידנית"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"לא ניתן היה להשלים את ההגדרה. הריצו פקודות אלה במסוף כדי להתקין את כלל הגישה"
" למכשיר, ולאחר מכן חברו את המכשיר מחדש."

