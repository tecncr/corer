#: src/window.py:149
msgid "Apple Device"
msgstr "Dispositiu Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer necessita permís per accedir a aquest dispositiu per USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Configura"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "El servei de dispositius del sistema (usbmuxd) no respon"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Reinicia'l"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "El servei de dispositius (usbmuxd) no està disponible"

#: src/window.py:260
msgid "USB access was set up"
msgstr "S'ha configurat l'accés per USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "S'ha reiniciat el servei de dispositius"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"No s'ha pogut reiniciar. Executeu «sudo systemctl restart usbmuxd» en un "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Configura l'accés per USB manualment"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"No s'ha pogut completar la configuració. Executeu aquestes ordres en un "
"terminal per instal·lar la regla d'accés al dispositiu i torneu a connectar-"
"lo."

#: src/window.py:301
msgid "_Close"
msgstr "_Tanca"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "C_opia les ordres"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "S'estan cercant les versions disponibles…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Trieu un fitxer de microprogramari per a aquest dispositiu"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr ""
"Actualment no hi ha cap microprogramari signat per a aquest dispositiu"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "S'està usant el fitxer de microprogramari"

#: src/window.py:422
msgid "Downloaded"
msgstr "Baixat"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Baixada de {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Fora de línia — es mostra el microprogramari baixat"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Usa un fitxer IPSW d'aquest ordinador"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} no és compatible amb aquest dispositiu"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Esborra i restaura"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Actualitza"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Surt del mode de _recuperació"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Entra en el mode de _recuperació"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Fitxers de microprogramari"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Trieu un fitxer de microprogramari"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Aquest fitxer no es pot utilitzar"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Voleu esborrar «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Tot el contingut i els ajustaments s'esborraran permanentment i "
"s'instal·larà {version}. Aquesta acció no es pot desfer."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Voleu actualitzar «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"S'instal·larà {version} i es conservaran el contingut i els ajustaments. "
"Assegureu-vos de tenir una còpia de seguretat abans de continuar."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Aquesta versió és anterior a la del dispositiu. Tornar a una versió anterior"
" sense esborrar probablement fallarà i pot causar la pèrdua total de les "
"dades."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Sembla que aquest microprogramari ja no està signat, de manera que el "
"dispositiu probablement el rebutjarà."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Mantingueu el dispositiu connectat fins que acabi el procés."

#: src/window.py:628
msgid "A device is being restored"
msgstr "S'està restaurant un dispositiu"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "S'està verificant el microprogramari"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "S'està baixant el microprogramari"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} de {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Voleu aturar el procés?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Si l'interrompeu ara, el dispositiu pot quedar inutilitzable fins que es "
"torni a restaurar."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continua"

#: src/window.py:789
msgid "_Stop"
msgstr "_Atura"

#: src/window.py:807
msgid "Stopping…"
msgstr "S'està aturant…"

#: src/window.py:839
msgid "Stopped"
msgstr "Aturat"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "S'han desat els blobs SHSH"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispositiu restaurat"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "El dispositiu es reiniciarà i mostrarà l'assistent de configuració."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispositiu actualitzat"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "El dispositiu es reiniciarà quan acabi d'actualitzar-se."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "No s'han pogut desar els blobs SHSH"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Ha fallat la restauració"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consulteu el registre per als detalls."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr ""
"No s'ha trobat el dispositiu. Torneu-lo a connectar i torneu-ho a provar"

#: src/window.py:925
msgid "The device is restarting"
msgstr "El dispositiu s'està reiniciant"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "No s'ha pogut sortir del mode de recuperació"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "El dispositiu s'està reiniciant en mode de recuperació"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"No s'ha pogut entrar en el mode de recuperació. Desbloquegeu el dispositiu i"
" confieu en aquest ordinador"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Voleu aturar-lo i sortir?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"S'està restaurant un dispositiu. Si l'interrompeu ara, pot quedar "
"inutilitzable fins que es torni a restaurar."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Atura i surt"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Menú principal"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Connecteu un dispositiu"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Connecteu un dispositiu Apple amb un cable USB. Els dispositius en mode de "
"recuperació o DFU també funcionen. Un Mac amb Apple silicon ha d'estar en "
"mode DFU."

