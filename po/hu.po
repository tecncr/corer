msgid "Device Updated"
msgstr "Az eszköz frissítve"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Az eszköz újraindul, amikor befejeződött a frissítés."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Az SHSH blobok mentése sikertelen"

#: src/window.py:859
