msgstr "Apple デバイス"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "USB 経由でこのデバイスにアクセスするには、Corer に許可が必要です"

#: src/window.py:218
msgid "_Set Up"
msgstr "設定(_S)"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "システムのデバイスサービス (usbmuxd) が応答していません"

#: src/window.py:224
msgid "_Restart It"
msgstr "再起動(_R)"

#: src/window.py:229
