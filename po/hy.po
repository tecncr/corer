msgid "Could Not Save SHSH Blobs"
msgstr "Չհաջողվեց պահել SHSH blob-երը"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Վերականգնումը ձախողվեց"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Մանրամասների համար տես մատյանը։"

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Սարքը չգտնվեց։ Նորից միացրեք այն և կրկին փորձեք"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Սարքը վերագործարկվում է"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Չհաջողվեց դուրս գալ վերականգնման ռեժիմից"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Սարքը վերագործարկվում է վերականգնման ռեժիմում"

