msgstr "Սարքերի ծառայությունը վերագործարկվեց"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Չհաջողվեց վերագործարկել։ Տերմինալում կատարեք «sudo systemctl restart "
"usbmuxd»"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Կարգավորել USB հասանելիությունը ձեռքով"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Կարգավորումը չհաջողվեց ավարտել։ Սարքի հասանելիության կանոնը տեղադրելու համար"
" տերմինալում կատարեք այս հրամանները, ապա նորից միացրեք սարքը։"

#: src/window.py:301
msgid "_Close"
msgstr "_Փակել"

#: src/window.py:302
