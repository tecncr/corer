msgid "Could not load the list of available versions"
msgstr "Nelze načíst seznam dostupných verzí"

#: src/firmware.py:185
msgid "This is not a valid firmware file"
msgstr "Toto není platný soubor firmwaru"

#: src/firmware.py:335
msgid "This firmware is not available for download"
msgstr "Tento firmware není k dispozici ke stažení"

#: src/firmware.py:349
msgid "Not enough free disk space to download the firmware"
msgstr "Nedostatek volného místa na disku pro stažení firmwaru"

#: src/firmware.py:360
msgid "The download server refused the request"
msgstr "Server pro stahování požadavek odmítl"

#: src/firmware.py:367
msgid "The download failed. Check your network connection"
msgstr "Stažení se nezdařilo. Zkontrolujte připojení k síti"

#: src/firmware.py:374
msgid "The downloaded firmware is incomplete"
msgstr "Stažený firmware je neúplný"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "Stažený firmware je poškozený"

#: src/log_dialog.py:16
msgid "Log"
msgstr "Protokol"

#: src/log_dialog.py:24
msgid "Copy"
msgstr "Kopírovat"

#: src/log_dialog.py:28
msgid "Save…"
msgstr "Uložit…"

#: src/log_dialog.py:36
msgid "No Log Yet"
msgstr "Zatím žádný protokol"

#: src/log_dialog.py:37
