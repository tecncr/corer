#: src/window.py:149
msgid "Apple Device"
msgstr "Apple-enhet"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer trenger tillatelse til å få tilgang til denne enheten via USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Sett opp"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Systemets enhetstjeneste (usbmuxd) svarer ikke"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Start på nytt"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Enhetstjenesten (usbmuxd) er ikke tilgjengelig"

#: src/window.py:260
msgid "USB access was set up"
msgstr "USB-tilgang ble satt opp"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Enhetstjenesten ble startet på nytt"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Kunne ikke starte på nytt. Kjør «sudo systemctl restart usbmuxd» i en "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Sett opp USB-tilgang manuelt"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Oppsettet kunne ikke fullføres. Kjør disse kommandoene i en terminal for å "
"installere regelen for enhetstilgang, og koble deretter til enheten på nytt."

#: src/window.py:301
msgid "_Close"
msgstr "_Lukk"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "K_opier kommandoer"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Ser etter tilgjengelige versjoner …"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Velg en fastvarefil for denne enheten"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Ingen fastvare er for øyeblikket signert for denne enheten"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Bruker fastvarefilen"

#: src/window.py:422
msgid "Downloaded"
msgstr "Lastet ned"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} nedlasting"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Frakoblet – viser nedlastet fastvare"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Bruk en IPSW-fil fra denne datamaskinen"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} er ikke kompatibel med denne enheten"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Slett og gjenopprett"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Oppdater"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Avslutt _gjenopprettingsmodus"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Gå inn i _gjenopprettingsmodus"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Fastvarefiler"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Velg fastvarefil"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Denne filen kan ikke brukes"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Slette «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Alt innhold og alle innstillinger slettes permanent, og {version} "
"installeres. Dette kan ikke angres."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Oppdatere «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} installeres, og innholdet og innstillingene dine beholdes. Pass på"
" at du har en sikkerhetskopi før du fortsetter."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Denne versjonen er eldre enn den som er på enheten. Nedgradering uten "
"sletting vil sannsynligvis mislykkes og kan føre til fullstendig datatap."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Denne fastvaren ser ikke lenger ut til å være signert, så enheten vil "
"sannsynligvis avvise den."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Hold enheten tilkoblet til prosessen er ferdig."

#: src/window.py:628
msgid "A device is being restored"
msgstr "En enhet gjenopprettes"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Bekrefter fastvare"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Laster ned fastvare"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} av {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Stoppe prosessen?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Hvis du avbryter nå, kan enheten bli ubrukelig til den gjenopprettes på "
"nytt."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Fortsett"

#: src/window.py:789
msgid "_Stop"
msgstr "_Stopp"

#: src/window.py:807
msgid "Stopping…"
msgstr "Stopper …"

#: src/window.py:839
msgid "Stopped"
msgstr "Stoppet"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH-blobber lagret"

#: src/window.py:845
msgid "Device Restored"
msgstr "Enheten er gjenopprettet"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Enheten starter på nytt og viser oppsettsassistenten."

#: src/window.py:849
msgid "Device Updated"
msgstr "Enheten er oppdatert"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Enheten starter på nytt når oppdateringen er ferdig."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Kunne ikke lagre SHSH-blobber"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Gjenopprettingen mislyktes"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Se loggen for detaljer."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Enheten ble ikke funnet. Koble den til på nytt og prøv igjen"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Enheten starter på nytt"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Kunne ikke avslutte gjenopprettingsmodus"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Enheten starter på nytt i gjenopprettingsmodus"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Kunne ikke gå inn i gjenopprettingsmodus. Lås opp enheten og stol på denne "
"datamaskinen"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Stoppe og avslutte?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"En enhet gjenopprettes. Hvis du avbryter nå, kan den bli ubrukelig til den "
"gjenopprettes på nytt."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Stopp og avslutt"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Hovedmeny"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Koble til en enhet"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Koble en Apple-enhet til med en USB-kabel. Enheter i gjenopprettings- eller "
"DFU-modus fungerer også. En Mac med Apple silicon må være i DFU-modus."

#: src/window.ui:124
msgid "Device"
msgstr "Enhet"

#: src/window.ui:131
msgid "Version"
msgstr "Versjon"

#: src/window.ui:145
msgid "Try Again"
msgstr "Prøv igjen"

#: src/window.ui:156
msgid "Firmware File"
msgstr "Fastvarefil"

#: src/window.ui:164
msgid "Remove File"
msgstr "Fjern fil"

#: src/window.ui:175
msgid "Choose File"
msgstr "Velg fil"

#: src/window.ui:190
msgid "Erase Device"
msgstr "Slett enhet"

#: src/window.ui:191
