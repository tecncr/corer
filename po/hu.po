#: src/window.py:149
msgid "Apple Device"
msgstr "Apple-eszköz"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr ""
"A Corernek engedélyre van szüksége, hogy USB-n keresztül hozzáférjen ehhez "
"az eszközhöz"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Beállítás"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "A rendszer eszközszolgáltatása (usbmuxd) nem válaszol"

#: src/window.py:224
msgid "_Restart It"
msgstr "Újra_indítás"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Az eszközszolgáltatás (usbmuxd) nem érhető el"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Az USB-hozzáférés beállítása megtörtént"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Az eszközszolgáltatás újraindult"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Az újraindítás nem sikerült. Futtassa a „sudo systemctl restart usbmuxd” "
"parancsot egy terminálban"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "USB-hozzáférés kézi beállítása"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"A beállítást nem sikerült befejezni. Futtassa ezeket a parancsokat egy "
"terminálban az eszközhozzáférési szabály telepítéséhez, majd csatlakoztassa "
"újra az eszközt."

#: src/window.py:301
msgid "_Close"
msgstr "_Bezárás"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "Parancsok _másolása"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Elérhető verziók keresése…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Válasszon firmware-fájlt ehhez az eszközhöz"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Jelenleg nincs aláírt firmware ehhez az eszközhöz"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "A használt firmware-fájl"

#: src/window.py:422
msgid "Downloaded"
msgstr "Letöltve"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "{size} letöltés"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Offline – a letöltött firmware látható"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "IPSW-fájl használata erről a számítógépről"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "A(z) {filename} nem kompatibilis ezzel az eszközzel"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Törlés és visszaállítás"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Frissítés"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Kilépés a _helyreállítási módból"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Belépés a _helyreállítási módba"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Firmware-fájlok"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Firmware-fájl kiválasztása"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Ez a fájl nem használható"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Törli a(z) „{name}” eszközt?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Minden tartalom és beállítás véglegesen törlődik, és a(z) {version} "
"telepítésre kerül. Ez nem vonható vissza."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Frissíti a(z) „{name}” eszközt?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"A(z) {version} telepítésre kerül, a tartalom és a beállítások megmaradnak. "
"Folytatás előtt győződjön meg arról, hogy van biztonsági mentése."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Ez a verzió régebbi, mint az eszközön lévő. A törlés nélküli visszalépés "
"valószínűleg sikertelen lesz, és a teljes adatvesztést okozhatja."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Úgy tűnik, ez a firmware már nincs aláírva, ezért az eszköz valószínűleg "
"elutasítja."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Tartsa csatlakoztatva az eszközt a folyamat befejezéséig."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Egy eszköz visszaállítása folyamatban van"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Firmware ellenőrzése"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Firmware letöltése"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} / {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Leállítja a folyamatot?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Ha most megszakítja, az eszköz használhatatlanná válhat a következő "
"visszaállításig."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Folytatás"

#: src/window.py:789
msgid "_Stop"
msgstr "_Leállítás"

#: src/window.py:807
msgid "Stopping…"
msgstr "Leállítás…"

#: src/window.py:839
msgid "Stopped"
msgstr "Leállítva"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobok mentve"

#: src/window.py:845
msgid "Device Restored"
msgstr "Az eszköz visszaállítva"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Az eszköz újraindul, és megjeleníti a beállítási asszisztenst."

