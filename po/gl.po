#: src/window.py:422
msgid "Downloaded"
msgstr "Descargado"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Descarga de {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Sen conexión: amosase o firmware descargado"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Usar un ficheiro IPSW deste computador"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} non é compatible con este dispositivo"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Borrar e restaurar"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Actualizar"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Saír do modo de _recuperación"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Entrar no modo de _recuperación"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Ficheiros de firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Escoller un ficheiro de firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Non se pode usar este ficheiro"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Borrar «{name}»?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Todo o contido e os axustes borraranse de forma permanente e instalarase "
"{version}. Esta acción non se pode desfacer."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Actualizar «{name}»?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Instalarase {version} e conservaranse o seu contido e os seus axustes. "
"Asegúrese de ter unha copia de seguranza antes de continuar."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Esta versión é anterior á do dispositivo. É probable que falle volver a unha"
" versión anterior sen borrar, e pode provocar a perda total dos datos."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Parece que este firmware xa non está asinado, polo que é probable que o "
"dispositivo o rexeite."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Manteña o dispositivo conectado ata que remate o proceso."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Estase restaurando un dispositivo"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Verificando o firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Descargando o firmware"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} de {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Deter o proceso?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Se o interrompe agora, o dispositivo pode quedar inutilizable ata que se "
"restaure de novo."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continuar"

#: src/window.py:789
msgid "_Stop"
msgstr "_Deter"

#: src/window.py:807
msgid "Stopping…"
msgstr "Detendo…"

#: src/window.py:839
msgid "Stopped"
msgstr "Detido"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Gardáronse os blobs SHSH"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispositivo restaurado"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "O dispositivo reiniciarase e amosará o asistente de configuración."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispositivo actualizado"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "O dispositivo reiniciarase cando remate de actualizarse."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Non foi posible gardar os blobs SHSH"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Fallou a restauración"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consulte o rexistro para ver os detalles."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Non se atopou o dispositivo. Volva conectalo e inténteo de novo"

#: src/window.py:925
msgid "The device is restarting"
msgstr "O dispositivo está a reiniciarse"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Non foi posible saír do modo de recuperación"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "O dispositivo está a reiniciarse en modo de recuperación"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Non foi posible entrar no modo de recuperación. Desbloquee o dispositivo e "
"confíe neste computador"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Deter e saír?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Estase restaurando un dispositivo. Se o interrompe agora, pode quedar "
"inutilizable ata que se restaure de novo."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Deter e saír"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Menú principal"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Conectar un dispositivo"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Conecte un dispositivo Apple cun cable USB. Tamén funcionan os dispositivos "
"en modo de recuperación ou DFU. Un Mac con Apple silicon ten que estar en "
"modo DFU."

