msgid "_Erase and Restore"
msgstr "_Löschen und wiederherstellen"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Aktualisieren"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "_Wiederherstellungsmodus verlassen"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "_Wiederherstellungsmodus aktivieren"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Firmware-Dateien"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Firmware-Datei auswählen"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Diese Datei kann nicht verwendet werden"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "„{name}“ löschen?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Alle Inhalte und Einstellungen werden dauerhaft gelöscht und {version} wird "
"installiert. Dies kann nicht rückgängig gemacht werden."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "„{name}“ aktualisieren?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} wird installiert, Ihre Inhalte und Einstellungen bleiben erhalten."
" Stellen Sie sicher, dass Sie eine Sicherung haben, bevor Sie fortfahren."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Diese Version ist älter als die auf dem Gerät. Ein Downgrade ohne Löschen "
"schlägt wahrscheinlich fehl und kann zum vollständigen Datenverlust führen."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Diese Firmware scheint nicht mehr signiert zu sein, daher wird das Gerät sie"
" wahrscheinlich ablehnen."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Lassen Sie das Gerät verbunden, bis der Vorgang abgeschlossen ist."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Ein Gerät wird wiederhergestellt"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Firmware wird überprüft"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Firmware wird heruntergeladen"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} von {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Vorgang anhalten?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Ein Abbruch jetzt kann das Gerät unbrauchbar machen, bis es erneut "
"wiederhergestellt wird."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Fortfahren"

#: src/window.py:789
msgid "_Stop"
msgstr "_Anhalten"

#: src/window.py:807
msgid "Stopping…"
msgstr "Wird angehalten …"

#: src/window.py:839
msgid "Stopped"
msgstr "Angehalten"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH-Blobs gespeichert"

#: src/window.py:845
msgid "Device Restored"
msgstr "Gerät wiederhergestellt"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr ""
"Das Gerät wird neu gestartet und zeigt den Einrichtungsassistenten an."

#: src/window.py:849
msgid "Device Updated"
msgstr "Gerät aktualisiert"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr ""
"Das Gerät wird neu gestartet, sobald die Aktualisierung abgeschlossen ist."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH-Blobs konnten nicht gespeichert werden"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Wiederherstellung fehlgeschlagen"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Details finden Sie im Protokoll."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr ""
"Das Gerät wurde nicht gefunden. Verbinden Sie es erneut und versuchen Sie es"
" noch einmal"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Das Gerät wird neu gestartet"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Der Wiederherstellungsmodus konnte nicht verlassen werden"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Das Gerät wird im Wiederherstellungsmodus neu gestartet"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Der Wiederherstellungsmodus konnte nicht aktiviert werden. Entsperren Sie "
"das Gerät und vertrauen Sie diesem Computer"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Anhalten und beenden?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Ein Gerät wird wiederhergestellt. Ein Abbruch jetzt kann es unbrauchbar "
"machen, bis es erneut wiederhergestellt wird."

#: src/window.py:963
msgid "_Stop and Quit"
