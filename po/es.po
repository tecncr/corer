msgstr "_Reiniciarlo"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "El servicio de dispositivos (usbmuxd) no está disponible"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Se configuró el acceso por USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Se reinició el servicio de dispositivos"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"No se pudo reiniciar. Ejecute «sudo systemctl restart usbmuxd» en una "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Configurar el acceso por USB manualmente"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"No se pudo completar la configuración. Ejecute estas órdenes en una terminal "
"para instalar la regla de acceso al dispositivo y luego vuelva a conectarlo."

#: src/window.py:301
