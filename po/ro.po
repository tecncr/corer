msgstr "C_opiază comenzile"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Se caută versiuni disponibile…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Alegeți un fișier de firmware pentru acest dispozitiv"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "În prezent nu este semnat niciun firmware pentru acest dispozitiv"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Se folosește fișierul de firmware"

#: src/window.py:422
msgid "Downloaded"
msgstr "Descărcat"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Descărcare de {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Deconectat — se afișează firmware-ul descărcat"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Folosește un fișier IPSW de pe acest calculator"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} nu este compatibil cu acest dispozitiv"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Șterge și restaurează"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Actualizează"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Ieși din modul de _recuperare"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Intră în modul de _recuperare"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Fișiere de firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Alege fișierul de firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Acest fișier nu poate fi folosit"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Ștergeți „{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Tot conținutul și toate setările vor fi șterse definitiv și se va instala "
"{version}. Această acțiune nu poate fi anulată."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Actualizați „{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"Se va instala {version}, iar conținutul și setările dvs. vor fi păstrate. "
"Asigurați-vă că aveți o copie de rezervă înainte de a continua."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Această versiune este mai veche decât cea de pe dispozitiv. Revenirea la o "
"versiune anterioară fără ștergere va eșua probabil și poate cauza pierderea "
"completă a datelor."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Acest firmware pare să nu mai fie semnat, așa că dispozitivul îl va refuza "
"probabil."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Păstrați dispozitivul conectat până se termină procesul."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Un dispozitiv este în curs de restaurare"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Se verifică firmware-ul"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Se descarcă firmware-ul"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} din {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Opriți procesul?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Întreruperea acum poate lăsa dispozitivul inutilizabil până când este "
"restaurat din nou."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Continuă"

#: src/window.py:789
msgid "_Stop"
msgstr "_Oprește"

#: src/window.py:807
msgid "Stopping…"
msgstr "Se oprește…"

#: src/window.py:839
msgid "Stopped"
msgstr "Oprit"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH blobs salvate"

#: src/window.py:845
msgid "Device Restored"
msgstr "Dispozitiv restaurat"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Dispozitivul va reporni și va afișa asistentul de configurare."

#: src/window.py:849
msgid "Device Updated"
msgstr "Dispozitiv actualizat"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Dispozitivul va reporni când se termină actualizarea."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "SHSH blobs nu au putut fi salvate"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Restaurarea a eșuat"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Consultați jurnalul pentru detalii."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Dispozitivul nu a fost găsit. Reconectați-l și încercați din nou"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Dispozitivul repornește"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Nu s-a putut ieși din modul de recuperare"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Dispozitivul repornește în modul de recuperare"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Nu s-a putut intra în modul de recuperare. Deblocați dispozitivul și "
"acordați încredere acestui calculator"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Opriți și ieșiți?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Un dispozitiv este în curs de restaurare. Întreruperea acum îl poate lăsa "
