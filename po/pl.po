msgid "View Log"
msgstr "Wyświetl dziennik"

#: src/shortcuts-dialog.ui:29
msgctxt "shortcut window"
msgid "General"
msgstr "Ogólne"

#: src/shortcuts-dialog.ui:32
msgctxt "shortcut window"
msgid "Preferences"
msgstr "Preferencje"

#: src/shortcuts-dialog.ui:38
msgctxt "shortcut window"
msgid "Show Shortcuts"
msgstr "Wyświetl skróty"

#: src/shortcuts-dialog.ui:44
msgctxt "shortcut window"
msgid "Quit"
msgstr "Zakończ"

#: src/window.py:149
msgid "Apple Device"
msgstr "Urządzenie Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer potrzebuje uprawnień do dostępu do tego urządzenia przez USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Skonfiguruj"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Systemowa usługa urządzeń (usbmuxd) nie odpowiada"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Uruchom ponownie"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Usługa urządzeń (usbmuxd) jest niedostępna"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Skonfigurowano dostęp przez USB"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Uruchomiono ponownie usługę urządzeń"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Nie można jej ponownie uruchomić. Wykonaj polecenie „sudo systemctl restart "
"usbmuxd” w terminalu"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Ręczna konfiguracja dostępu przez USB"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Nie udało się ukończyć konfiguracji. Wykonaj te polecenia w terminalu, aby "
"zainstalować regułę dostępu do urządzenia, a następnie podłącz urządzenie "
"ponownie."

#: src/window.py:301
msgid "_Close"
msgstr "_Zamknij"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "S_kopiuj polecenia"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Wyszukiwanie dostępnych wersji…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Wybierz plik oprogramowania układowego dla tego urządzenia"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr ""
"Obecnie żadne oprogramowanie układowe nie jest podpisane dla tego urządzenia"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Używany plik oprogramowania układowego"

#: src/window.py:422
msgid "Downloaded"
msgstr "Pobrano"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Pobieranie: {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Bez połączenia — wyświetlane jest pobrane oprogramowanie układowe"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Użyj pliku IPSW z tego komputera"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "Plik {filename} nie jest zgodny z tym urządzeniem"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Wymaż i przywróć"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Zaktualizuj"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Wyjdź z _trybu odzyskiwania"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Przejdź do _trybu odzyskiwania"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Pliki oprogramowania układowego"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Wybierz plik oprogramowania układowego"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Ten plik nie może zostać użyty"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Wymazać „{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Cała zawartość i ustawienia zostaną trwale wymazane, a system {version} "
"zostanie zainstalowany. Tej czynności nie można cofnąć."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Zaktualizować „{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"System {version} zostanie zainstalowany, a zawartość i ustawienia zostaną "
"zachowane. Przed kontynuowaniem upewnij się, że masz kopię zapasową."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Ta wersja jest starsza od tej na urządzeniu. Przywrócenie starszej wersji "
"bez wymazywania prawdopodobnie się nie powiedzie i może spowodować całkowitą"
" utratę danych."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"To oprogramowanie układowe wydaje się już nie być podpisane, więc urządzenie"
" prawdopodobnie je odrzuci."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Pozostaw urządzenie podłączone do zakończenia procesu."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Urządzenie jest przywracane"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Weryfikowanie oprogramowania układowego"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Pobieranie oprogramowania układowego"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} z {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/s"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Zatrzymać proces?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Przerwanie teraz może pozostawić urządzenie bezużytecznym do czasu ponownego"
" przywrócenia."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Kontynuuj"

#: src/window.py:789
msgid "_Stop"
msgstr "_Zatrzymaj"

#: src/window.py:807
msgid "Stopping…"
msgstr "Zatrzymywanie…"

#: src/window.py:839
msgid "Stopped"
msgstr "Zatrzymano"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "Zapisano SHSH blobs"

#: src/window.py:845
msgid "Device Restored"
msgstr "Przywrócono urządzenie"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Urządzenie uruchomi się ponownie i wyświetli asystenta ustawień."

#: src/window.py:849
msgid "Device Updated"
msgstr "Zaktualizowano urządzenie"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Urządzenie uruchomi się ponownie po zakończeniu aktualizacji."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Nie można zapisać SHSH blobs"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Przywracanie się nie powiodło"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Szczegóły można znaleźć w dzienniku."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Nie znaleziono urządzenia. Podłącz je ponownie i spróbuj jeszcze raz"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Urządzenie uruchamia się ponownie"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Nie można wyjść z trybu odzyskiwania"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Urządzenie uruchamia się ponownie w trybie odzyskiwania"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Nie można przejść do trybu odzyskiwania. Odblokuj urządzenie i zaufaj temu "
"komputerowi"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Zatrzymać i zakończyć?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Urządzenie jest przywracane. Przerwanie teraz może pozostawić je "
"bezużytecznym do czasu ponownego przywrócenia."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Zatrzymaj i zakończ"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Menu główne"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Podłącz urządzenie"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Podłącz urządzenie Apple kablem USB. Urządzenia w trybie odzyskiwania lub "
"DFU również działają. Mac z układem Apple silicon musi być w trybie DFU."

