msgid "The downloaded firmware is incomplete"
msgstr "البرنامج الثابت المنزَّل غير مكتمل"

#: src/firmware.py:377
msgid "The downloaded firmware is corrupted"
msgstr "البرنامج الثابت المنزَّل تالف"

