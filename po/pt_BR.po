msgstr "O serviço de dispositivos foi reiniciado"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Não foi possível reiniciar. Execute “sudo systemctl restart usbmuxd” em um "
