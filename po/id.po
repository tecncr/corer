#: src/window.py:149
msgid "Apple Device"
msgstr "Perangkat Apple"

#: src/window.py:217
msgid "Corer needs permission to access this device over USB"
msgstr "Corer memerlukan izin untuk mengakses perangkat ini melalui USB"

#: src/window.py:218
msgid "_Set Up"
msgstr "_Siapkan"

#: src/window.py:223
msgid "The system device service (usbmuxd) is not responding"
msgstr "Layanan perangkat sistem (usbmuxd) tidak merespons"

#: src/window.py:224
msgid "_Restart It"
msgstr "_Mulai Ulang"

#: src/window.py:229
msgid "The device service (usbmuxd) is not available"
msgstr "Layanan perangkat (usbmuxd) tidak tersedia"

#: src/window.py:260
msgid "USB access was set up"
msgstr "Akses USB telah disiapkan"

#: src/window.py:273
msgid "The device service was restarted"
msgstr "Layanan perangkat telah dimulai ulang"

#: src/window.py:275
msgid ""
"Could not restart it. Run “sudo systemctl restart usbmuxd” in a terminal"
msgstr ""
"Tidak dapat memulai ulang. Jalankan “sudo systemctl restart usbmuxd” di "
"terminal"

#: src/window.py:284
msgid "Set Up USB Access Manually"
msgstr "Siapkan Akses USB Secara Manual"

#: src/window.py:285
msgid ""
"The setup could not be completed. Run these commands in a terminal to "
"install the device access rule, then reconnect the device."
msgstr ""
"Penyiapan tidak dapat diselesaikan. Jalankan perintah berikut di terminal "
"untuk memasang aturan akses perangkat, lalu sambungkan kembali perangkat."

#: src/window.py:301
msgid "_Close"
msgstr "_Tutup"

#: src/window.py:302
msgid "C_opy Commands"
msgstr "Salin _Perintah"

#: src/window.py:410
msgid "Looking for available versions…"
msgstr "Mencari versi yang tersedia…"

#: src/window.py:414
msgid "Choose a firmware file for this device"
msgstr "Pilih berkas firmware untuk perangkat ini"

#: src/window.py:416
msgid "No firmware is currently signed for this device"
msgstr "Saat ini tidak ada firmware yang ditandatangani untuk perangkat ini"

#: src/window.py:418
msgid "Using the firmware file"
msgstr "Menggunakan berkas firmware"

#: src/window.py:422
msgid "Downloaded"
msgstr "Terunduh"

#. Translators: {size} is a file size such as “8.1 GB”
#: src/window.py:425
#, python-brace-format
msgid "{size} download"
msgstr "Unduhan {size}"

#: src/window.py:429
msgid "Offline — showing downloaded firmware"
msgstr "Luring — menampilkan firmware yang diunduh"

#: src/window.py:436
msgid "Use an IPSW file from this computer"
msgstr "Gunakan berkas IPSW dari komputer ini"

#. Translators: {filename} is the name of a firmware file
#: src/window.py:440
#, python-brace-format
msgid "{filename} is not compatible with this device"
msgstr "{filename} tidak kompatibel dengan perangkat ini"

#: src/window.py:453 src/window.py:587
msgid "_Erase and Restore"
msgstr "_Hapus dan Pulihkan"

#: src/window.py:453 src/window.py:591
msgid "_Update"
msgstr "_Perbarui"

#: src/window.py:468
msgid "Exit _Recovery Mode"
msgstr "Keluar dari _Mode Pemulihan"

#: src/window.py:471
msgid "Enter _Recovery Mode"
msgstr "Masuk ke _Mode Pemulihan"

#: src/window.py:502
msgid "Firmware Files"
msgstr "Berkas Firmware"

#: src/window.py:507
msgid "Choose Firmware File"
msgstr "Pilih Berkas Firmware"

#: src/window.py:518
msgid "This file cannot be used"
msgstr "Berkas ini tidak dapat digunakan"

#. Translators: {name} is the name of a device
#: src/window.py:563
#, python-brace-format
msgid "Erase “{name}”?"
msgstr "Hapus “{name}”?"

#. Translators: {version} is a system version such as “iOS 18.1”
#: src/window.py:565
#, python-brace-format
msgid ""
"All content and settings will be permanently erased and {version} will be "
"installed. This cannot be undone."
msgstr ""
"Semua konten dan pengaturan akan dihapus secara permanen dan {version} akan "
"dipasang. Tindakan ini tidak dapat dibatalkan."

#: src/window.py:569
#, python-brace-format
msgid "Update “{name}”?"
msgstr "Perbarui “{name}”?"

#: src/window.py:570
#, python-brace-format
msgid ""
"{version} will be installed and your content and settings will be kept. Make"
" sure you have a backup before continuing."
msgstr ""
"{version} akan dipasang dan konten serta pengaturan Anda akan dipertahankan."
" Pastikan Anda memiliki cadangan sebelum melanjutkan."

#: src/window.py:576
msgid ""
"This version is older than the one on the device. Downgrading without "
"erasing is likely to fail and can cause complete data loss."
msgstr ""
"Versi ini lebih lama daripada versi di perangkat. Menurunkan versi tanpa "
"menghapus kemungkinan besar gagal dan dapat menyebabkan kehilangan seluruh "
"data."

#: src/window.py:580
msgid ""
"This firmware no longer appears to be signed, so the device will probably "
"refuse it."
msgstr ""
"Firmware ini tampaknya tidak lagi ditandatangani, sehingga perangkat "
"kemungkinan akan menolaknya."

#: src/window.py:582
msgid "Keep the device connected until the process finishes."
msgstr "Biarkan perangkat tetap terhubung hingga proses selesai."

#: src/window.py:628
msgid "A device is being restored"
msgstr "Sebuah perangkat sedang dipulihkan"

#: src/window.py:640 src/window.py:666
msgid "Verifying Firmware"
msgstr "Memverifikasi Firmware"

#: src/window.py:642 src/window.py:668
msgid "Downloading Firmware"
msgstr "Mengunduh Firmware"

#. Translators: download progress, e.g. “1.2 GB of 8.1 GB”
#: src/window.py:672
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} dari {total}"

#. Translators: download speed, e.g. “12.5 MB/s”
#: src/window.py:679
#, python-brace-format
msgid "{speed}/s"
msgstr "{speed}/dtk"

#: src/window.py:785
msgid "Stop the Process?"
msgstr "Hentikan Proses?"

#: src/window.py:786
msgid ""
"Interrupting now can leave the device unusable until it is restored again."
msgstr ""
"Menginterupsi sekarang dapat membuat perangkat tidak dapat digunakan hingga "
"dipulihkan lagi."

#: src/window.py:788 src/window.py:962
msgid "_Continue"
msgstr "_Lanjutkan"

#: src/window.py:789
msgid "_Stop"
msgstr "_Hentikan"

#: src/window.py:807
msgid "Stopping…"
msgstr "Menghentikan…"

#: src/window.py:839
msgid "Stopped"
msgstr "Dihentikan"

#: src/window.py:842
msgid "SHSH Blobs Saved"
msgstr "SHSH Blob Tersimpan"

#: src/window.py:845
msgid "Device Restored"
msgstr "Perangkat Dipulihkan"

#: src/window.py:846
msgid "The device will restart and show the setup assistant."
msgstr "Perangkat akan dimulai ulang dan menampilkan asisten penyiapan."

#: src/window.py:849
msgid "Device Updated"
msgstr "Perangkat Diperbarui"

#: src/window.py:850
msgid "The device will restart when it has finished updating."
msgstr "Perangkat akan dimulai ulang setelah selesai diperbarui."

#: src/window.py:858
msgid "Could Not Save SHSH Blobs"
msgstr "Tidak Dapat Menyimpan SHSH Blob"

#: src/window.py:859
msgid "Restore Failed"
msgstr "Pemulihan Gagal"

#: src/window.py:863
msgid "Check the log for details."
msgstr "Periksa log untuk detailnya."

#: src/window.py:899
msgid "The device was not found. Reconnect it and try again"
msgstr "Perangkat tidak ditemukan. Sambungkan kembali dan coba lagi"

#: src/window.py:925
msgid "The device is restarting"
msgstr "Perangkat sedang dimulai ulang"

#: src/window.py:926
msgid "Could not exit recovery mode"
msgstr "Tidak dapat keluar dari mode pemulihan"

#: src/window.py:929
msgid "The device is restarting in recovery mode"
msgstr "Perangkat sedang dimulai ulang dalam mode pemulihan"

#: src/window.py:930
msgid ""
"Could not enter recovery mode. Unlock the device and trust this computer"
msgstr ""
"Tidak dapat masuk ke mode pemulihan. Buka kunci perangkat dan percayai "
"komputer ini"

#: src/window.py:959
msgid "Stop and Quit?"
msgstr "Hentikan dan Keluar?"

#: src/window.py:960
msgid ""
"A device is being restored. Interrupting now can leave it unusable until it "
"is restored again."
msgstr ""
"Sebuah perangkat sedang dipulihkan. Menginterupsi sekarang dapat membuatnya "
"tidak dapat digunakan hingga dipulihkan lagi."

#: src/window.py:963
msgid "_Stop and Quit"
msgstr "_Hentikan dan Keluar"

#: src/window.ui:21
msgid "Main Menu"
msgstr "Menu Utama"

#: src/window.ui:56
msgid "Connect a Device"
msgstr "Hubungkan Perangkat"

#: src/window.ui:57
msgid ""
"Plug in an Apple device with a USB cable. Devices in recovery or DFU mode "
"work too. A Mac with Apple silicon has to be in DFU mode."
msgstr ""
"Colokkan perangkat Apple dengan kabel USB. Perangkat dalam mode pemulihan "
"atau DFU juga dapat digunakan. Mac dengan Apple silicon harus berada dalam "
"mode DFU."

#: src/window.ui:124
msgid "Device"
msgstr "Perangkat"

#: src/window.ui:131
msgid "Version"
msgstr "Versi"

